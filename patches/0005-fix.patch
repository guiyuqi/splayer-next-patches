 2 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/electron/main/services/playerControl.ts b/electron/main/services/playerControl.ts
index a2732fd..2ccdfce 100644
--- a/electron/main/services/playerControl.ts
+++ b/electron/main/services/playerControl.ts
@@ -8,7 +8,7 @@
 import { getPlayer } from "@main/services/engine";
 import { sendToMain } from "@main/utils/broadcast";
 import { toMs } from "@main/utils/time";
-import type { ShuffleMode, RepeatMode, Track } from "@shared/types/player";
+import type { PlaybackContext, ShuffleMode, RepeatMode, Track } from "@shared/types/player";
 
 /**
  * 跳转（毫秒）
@@ -36,10 +36,30 @@ export const playerControl = {
     sendToMain("player:event", { type: "setRepeat", data: { mode } }),
   playTrack: (track: Track): void =>
     sendToMain("player:event", { type: "playTrack", data: { track } }),
+  playList: (tracks: Track[], index: number, context?: PlaybackContext): void =>
+    sendToMain("player:event", { type: "playList", data: { tracks, index, context } }),
   addToQueue: (tracks: Track[], position: "next" | "end"): void =>
     sendToMain("player:event", { type: "addToQueue", data: { tracks, position } }),
+  removeFromQueue: (index: number): void =>
+    sendToMain("player:event", { type: "removeFromQueue", data: { index } }),
+  moveInQueue: (from: number, to: number): void =>
+    sendToMain("player:event", { type: "moveInQueue", data: { from, to } }),
+  clearQueue: (): void => sendToMain("player:event", { type: "clearQueue" }),
+  jumpToIndex: (index: number): void =>
+    sendToMain("player:event", { type: "jumpToIndex", data: { index } }),
+  toggleLike: (): void => sendToMain("player:event", { type: "toggleLike" }),
   seek,
-  setVolume: (volume: number): void => getPlayer().setVolume(volume),
+  /**
+   * 设置音量
+   *
+   * 引擎先落地（无渲染层时也生效），再通知渲染层同步状态：滑块、持久化值与媒体会话
+   * 都由渲染层那条 IPC 路径负责，否则外部改音量后界面与下次启动会把旧值反推回来。
+   * @param volume - 音量（0 ~ 1）
+   */
+  setVolume: (volume: number): void => {
+    getPlayer().setVolume(volume);
+    sendToMain("player:event", { type: "setVolume", data: { volume } });
+  },
   /** 当前播放进度（毫秒） */
   getPosition: (): number => toMs(getPlayer().getPosition()),
 };
diff --git a/src/core/player/events.ts b/src/core/player/events.ts
index aaa0f9d..8835ad4 100644
--- a/src/core/player/events.ts
+++ b/src/core/player/events.ts
@@ -11,6 +11,8 @@ import * as abLoop from "@/services/abLoop";
 import * as cacheScheduler from "@/services/cacheScheduler";
 import { setDeviceVolume } from "@/services/deviceVolume";
 import * as playStats from "./stats";
+import { clearQueue } from "@/stores/queue";
+import { useThemeStore } from "@/stores/theme";
 import {
   applySavedVolumeForActiveDevice,
   getActiveDeviceId,
@@ -20,16 +22,22 @@ import {
   isSmartTransitionActive,
   isSeeking,
   markSeek,
+  moveInQueue,
   nextTrack,
   pause,
   play,
+  playAtIndex,
+  playFrom,
   playNow,
   prevTrack,
   recoverFromSourceFailure,
   refreshDevices,
+  removeFromQueue,
   seek,
   setRepeatMode,
   setShuffleMode,
+  setVolume,
+  stop,
   trySmartTransition,
 } from "./index";
 
@@ -150,6 +158,10 @@ export const handleEvent = async (event: PlayerEvent): Promise<void> => {
     case "playTrack":
       await playNow(event.data.track);
       break;
+    case "playList":
+      // 整列表入队并从指定下标起播（歌单/列表来源的外部播放指令）
+      await playFrom(event.data.tracks, event.data.index, event.data.context);
+      break;
     case "pause":
       await pause();
       break;
@@ -165,9 +177,30 @@ export const handleEvent = async (event: PlayerEvent): Promise<void> => {
     case "setRepeat":
       setRepeatMode(event.data.mode);
       break;
+    case "setVolume":
+      // 外部（MCP / 外部 API）改音量：走渲染层同一条路径，顺带同步滑块、持久化与媒体会话
+      await setVolume(event.data.volume);
+      break;
     case "addToQueue":
       insertManyToQueue(event.data.tracks, event.data.position);
       break;
+    case "removeFromQueue":
+      await removeFromQueue(event.data.index);
+      break;
+    case "moveInQueue":
+      moveInQueue(event.data.from, event.data.to);
+      break;
+    case "clearQueue":
+      // 与队列面板的清空一致：停播、丢队列、清当前曲目
+      await stop();
+      status.playIndex = -1;
+      clearQueue();
+      useMediaStore().clear();
+      useThemeStore().coverColor = null;
+      break;
+    case "jumpToIndex":
+      await playAtIndex(event.data.index);
+      break;
     case "toggleLike":
       await useFavorite().toggle(useMediaStore().track);
       break;
