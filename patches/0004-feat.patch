diff --git a/src/components/list/SongList.vue b/src/components/list/SongList.vue
index cfd3701..3adfd4e 100644
--- a/src/components/list/SongList.vue
+++ b/src/components/list/SongList.vue
@@ -250,6 +250,13 @@ const { items: contextMenuItems, handleSelect: onContextMenu } = useTrackMenu(co
   collectionType: props.collectionType,
   canRemove: props.canRemove,
   playbackContext: computed(() => props.playbackContext),
+  // 与列表点播保持一致，遵循「点单曲时载入所在列表」
+  onPlay: (track) => {
+    playTrackAt(
+      track,
+      sortedItems.value.findIndex((item) => item.id === track.id),
+    );
+  },
   onAddToPlaylist: (track) => openPicker([track]),
   onRemove: (track) => batch.requestDelete([track], "remove"),
   onDeleteFile: (track) => batch.requestDelete([track], "file"),
@@ -270,6 +277,21 @@ const onListContextMenu = (event: MouseEvent): void => {
   }
 };
 
+/**
+ * 播放列表中的某首歌
+ * 默认把当前列表整体载入队列，便于从歌单/专辑直接续播；搜索页仍遵循「搜索页播放行为」
+ * @param item - 歌曲数据
+ * @param index - 列表索引
+ */
+const playTrackAt = (item: Track, index: number): void => {
+  const singleFromSearch = route.name === "search" && settings.player.searchPlayBehavior !== "all";
+  if (!singleFromSearch && settings.player.playFromSourceList && sortedItems.value.length > 1) {
+    void player.playFrom(sortedItems.value, index, props.playbackContext);
+    return;
+  }
+  void player.playNow(item, props.playbackContext);
+};
+
 /**
  * 双击歌曲项播放
  * @param item - 歌曲数据
@@ -277,11 +299,7 @@ const onListContextMenu = (event: MouseEvent): void => {
  */
 const onTrackDblClick = (item: Track, index: number): void => {
   if (batch.active.value) return;
-  if (route.name === "search" && settings.player.searchPlayBehavior !== "all") {
-    void player.playNow(item, props.playbackContext);
-    return;
-  }
-  void player.playFrom(sortedItems.value, index, props.playbackContext);
+  playTrackAt(item, index);
 };
 
 const emit = defineEmits<{
@@ -545,7 +563,7 @@ defineExpose({
                     ? batch.toggle(item.id)
                     : playingId === item.id
                       ? player.togglePlay()
-                      : player.playNow(item, props.playbackContext)
+                      : playTrackAt(item, index)
                 "
               >
                 <!-- 多选模式 -->
