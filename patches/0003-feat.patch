     wordFadeWidth: DEFAULTS.wordFadeWidth,
     scrollResetDelay: DEFAULTS.scrollResetDelay,
     minInterludeGap: DEFAULTS.minInterludeGap,
@@ -123,6 +129,11 @@ const props = withDefaults(
   },
 );
 
+/** 水平偏移：按歌词区域宽度的百分比平移，值为 0 时不产生 transform */
+const offsetStyle = computed(() =>
+  props.offsetX ? { transform: `translateX(${props.offsetX}%)` } : undefined,
+);
+
 interface Emits {
   /** 用户点击歌词行时触发，参数为该行起始时间（毫秒），用于跳转播放进度 */
   (e: "seek", timeMs: number): void;
@@ -314,7 +325,7 @@ watch(
 </script>
 
 <template>
-  <div ref="containerRef">
+  <div ref="containerRef" :class="alignCenter ? 'lyric-align-center' : ''" :style="offsetStyle">
     <Teleport v-if="bottomLineEl" :to="bottomLineEl">
       <slot name="bottom">
         <LyricCredit />
@@ -322,3 +333,33 @@ watch(
     </Teleport>
   </div>
 </template>
+
+<style scoped>
+/* 居中显示：缩放原点改为居中，避免激活行从左边缘放大 */
+.lyric-align-center :deep(.lp-line) {
+  text-align: center;
+  transform-origin: center;
+}
+
+/* 行内容是 width: fit-content 的块级盒子，text-align 挪不动它；
+   库自身用 margin-left: auto 对齐对唱行，这里用同样方式居中普通行（对唱行保持右对齐） */
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-content) {
+  margin-inline: auto;
+}
+
+/* 显式覆盖各级容器：单一 text-align 会被中间层自身的对齐方式截断，导致换行行左起 */
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-content),
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-main),
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-sub),
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-line-bg) {
+  text-align: center !important;
+}
+
+/* 逐词音译盒子：库为每行首个词设了 `:first-child { text-align: left; align-items: flex-start }`
+   （左对齐布局下让音译贴住行首），整行为单词语时它必然命中，音译便被钉在左边缘。
+   居中模式下要连它一起覆盖；内部 .lp-word-text / .lp-roman-word 是 text-align: inherit，会跟随居中 */
+.lyric-align-center :deep(.lp-line:not(.duet) .lp-main > .lp-word-roman) {
+  text-align: center !important;
+  align-items: center;
+}
+</style>
