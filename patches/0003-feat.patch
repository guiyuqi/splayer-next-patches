 interface Emits {
   /** 点击歌词行进行播放进度跳转 */
   (e: "seek", timeMs: number): void;
@@ -84,14 +95,26 @@ const nextFrame = (): Promise<void> =>
 // 处理多语言显隐及音译偏好的本地高效清洗
 const processedLyrics = computed(() => {
   if (!props.lyricLines) return [];
+  // AMLL 只在整曲每行词数均 ≤1 时走 non-dynamic 快速路径，此时逐词渲染被整体跳过，
+  // 逐词音译不会出现在任何元素里（库内部按未拆分的 words.length 判定，等价于此处判断）
+  const nonDynamic = props.lyricLines.every((line) => line.words.length <= 1);
   return props.lyricLines.map((line) => {
     const hasWordRoman = line.words.some((w) => Boolean(w.romanWord?.trim()));
     const showWordRomanForLine = props.showWordRomanization && hasWordRoman;
     const showLineRomanForLine = props.showRomanization && !showWordRomanForLine;
+    // 逐词音译无法渲染时回退到行级音译，优先用歌词自带的行级文本，缺失则由逐词音译拼回
+    const wordRomanFallback =
+      showWordRomanForLine && nonDynamic
+        ? line.romanLyric?.trim() ||
+          line.words
+            .map((w) => w.romanWord?.trim())
+            .filter(Boolean)
+            .join(" ")
+        : "";
     const newLine = {
       ...line,
       translatedLyric: props.showTranslation ? line.translatedLyric : "",
-      romanLyric: showLineRomanForLine ? line.romanLyric : "",
+      romanLyric: showLineRomanForLine ? line.romanLyric : wordRomanFallback,
     };
     if (line.words) {
       newLine.words = line.words.map((word) => {
@@ -371,7 +394,12 @@ defineExpose({
 </script>
 
 <template>
-  <div ref="wrapperRef" class="amll-lyrics-container" :class="contentVisible ? 'is-visible' : ''" />
+  <div
+    ref="wrapperRef"
+    class="amll-lyrics-container"
+    :class="[contentVisible ? 'is-visible' : '', alignCenter ? 'is-align-center' : '']"
+    :style="offsetStyle"
+  />
   <Teleport v-if="bottomLineEl" :to="bottomLineEl">
     <slot name="bottom">
       <LyricCredit />
@@ -380,6 +408,14 @@ defineExpose({
 </template>
 
 <style scoped>
+/* 居中显示：作用于歌词行与主行；对唱行自带 text-align: right 属于自身声明，不受继承影响。
+   不再下沉到 span —— 库在 span 上为逐词罗马音/注音设了自己的对齐方式，覆盖会导致音译错位 */
+.amll-lyrics-container.is-align-center :deep([class*="lyricLine"]:not([class*="lyricDuetLine"])),
+.amll-lyrics-container.is-align-center
+  :deep([class*="lyricLine"]:not([class*="lyricDuetLine"]) [class*="lyricMainLine"]) {
+  text-align: center !important;
+}
+
 .amll-lyrics-container {
   width: 100%;
   height: 100%;
