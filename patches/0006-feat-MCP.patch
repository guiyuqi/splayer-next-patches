+/**
+ * 读取本机歌单的曲目 id 顺序
+ * @param id - 歌单 ID
+ * @returns 按位置排序的曲目 id
+ */
+export const getPlaylistTrackIds = (id: string): string[] =>
+  (
+    getDb()
+      .prepare("SELECT track_id FROM playlist_tracks WHERE playlist_id = ? ORDER BY position")
+      .all(id) as { track_id: string }[]
+  ).map((row) => row.track_id);
+
+/**
+ * 重排本机歌单曲序
+ *
+ * 本机歌单在同一条 SQLite 事务里改 position，天然原子，也不会变动"加入时间"。
+ * 顺序数组必须与当前曲目集合完全一致，避免误删或漏项。
+ * @param id - 歌单 ID
+ * @param orderedTrackIds - 期望的完整顺序
+ * @returns 是否写入成功
+ */
+export const reorderPlaylistTracks = (id: string, orderedTrackIds: string[]): boolean => {
+  const playlist = getPlaylists().find((item) => item.id === id);
+  if (!playlist || playlist.type !== "local") return false;
+  const next = [...new Set(orderedTrackIds)];
+  const database = getDb();
+  return database.transaction(() => {
+    const current = getPlaylistTrackIds(id);
+    if (next.length !== current.length) return false;
+    const currentSet = new Set(current);
+    if (!next.every((trackId) => currentSet.has(trackId))) return false;
+    const update = database.prepare(
+      "UPDATE playlist_tracks SET position = ? WHERE playlist_id = ? AND track_id = ?",
+    );
+    next.forEach((trackId, position) => update.run(position, id, trackId));
+    database.prepare("UPDATE playlists SET updated_at = ? WHERE id = ?").run(Date.now(), id);
+    return true;
+  })();
+};
+
