+import { callNetease } from "@main/apis/netease";
+import { songToTrack, type NeteaseRawSong } from "@shared/utils/netease";
+import type { Track } from "@shared/types/player";
+import { cacheTracks } from "./cache";
+import { getNeteaseUserId } from "./playlists";
+
+/** song_detail 单批曲目上限 */
+const SONG_DETAIL_BATCH = 500;
+
+export interface LikedTracksResult {
+  total: number;
+  offset: number;
+  limit: number;
+  /** 本页的网易云歌曲 id（全量列表的切片） */
+  ids: string[];
+  tracks: Track[];
+}
+
+/**
+ * 读取「喜欢的音乐」曲目
+ *
+ * 先取全量 id（likelist 只回 id），再按需分页补歌名/歌手，避免一次拉全量。
+ * @param offset - 起始下标（从 0 开始）
+ * @param limit - 本页数量
+ * @returns 曲目总数与本页曲目
+ */
+export const listLikedTracks = async (
+  offset: number,
+  limit: number,
+): Promise<LikedTracksResult> => {
+  const uid = await getNeteaseUserId();
+  if (uid === null) throw new Error("网易云账号未登录，无法读取「喜欢的音乐」");
+  const { body } = await callNetease("likelist", { uid });
+  const allIds = ((body?.ids ?? []) as (number | string)[]).map(String);
+  const ids = allIds.slice(offset, offset + limit);
+
+  const byId = new Map<string, Track>();
+  for (let i = 0; i < ids.length; i += SONG_DETAIL_BATCH) {
+    const chunk = ids.slice(i, i + SONG_DETAIL_BATCH);
+    const { body: detail } = await callNetease("song_detail", { ids: chunk.join(",") });
+    for (const song of (detail?.songs ?? []) as NeteaseRawSong[]) {
+      byId.set(String(song.id), songToTrack(song));
+    }
+  }
+
+  const tracks = ids.flatMap((id) => {
+    const track = byId.get(id);
+    return track ? [track] : [];
+  });
+  cacheTracks(tracks);
+  return { total: allIds.length, offset, limit, ids, tracks };
+};
