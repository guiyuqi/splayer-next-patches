diff --git a/src/services/queueSync.ts b/src/services/queueSync.ts
new file mode 100644
index 0000000..9e6e587
--- /dev/null
+++ b/src/services/queueSync.ts
@@ -0,0 +1,49 @@
+import { watch } from "vue";
+import { QUEUE_WINDOW_RADIUS, type NowPlayingQueueSnapshot } from "@shared/types/nowPlaying";
+import { queueEntries } from "@/stores/queue";
+import { useStatusStore } from "@/stores/status";
+
+/** 队列窗口推送的去抖间隔（毫秒）：一次操作可能连续改动队列与索引 */
+const SYNC_DEBOUNCE_MS = 200;
+
+/**
+ * 构造以当前曲目为中心的队列窗口
+ * @param index - 当前播放索引
+ * @returns 队列窗口快照
+ */
+const buildQueueSnapshot = (index: number): NowPlayingQueueSnapshot => {
+  const entries = queueEntries.value;
+  const start = Math.max(0, index - QUEUE_WINDOW_RADIUS);
+  const end = Math.min(entries.length, index + QUEUE_WINDOW_RADIUS + 1);
+  return {
+    index,
+    total: entries.length,
+    startIndex: start,
+    tracks: entries.slice(start, end).map(({ track }) => ({
+      id: track.id,
+      title: track.title,
+      artists: track.artists.map((artist) => artist.name),
+      durationMs: track.duration,
+    })),
+  };
+};
+
+/**
+ * 把播放队列窗口同步到主进程，供 MCP / 外部客户端读取当前播放上下文
+ * 窗口只含当前曲目前后有限首，避免整条队列经 IPC 反复传输
+ */
+export const startQueueSync = (): void => {
+  const status = useStatusStore();
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  watch(
+    [queueEntries, () => status.playIndex],
+    () => {
+      if (timer) clearTimeout(timer);
+      timer = setTimeout(() => {
+        timer = null;
+        window.api.nowPlaying.updateQueue(buildQueueSnapshot(status.playIndex));
+      }, SYNC_DEBOUNCE_MS);
+    },
+    { immediate: true },
+  );
+};
