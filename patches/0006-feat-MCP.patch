+import { describe, expect, it } from "vitest";
+import type { NetworkInterfaceInfo } from "node:os";
+import { pickWslAddresses } from "./lan";
+
+const iface = (address: string, family: "IPv4" | "IPv6" = "IPv4"): NetworkInterfaceInfo =>
+  family === "IPv4"
+    ? {
+        address,
+        netmask: "255.255.240.0",
+        family,
+        mac: "00:00:00:00:00:00",
+        internal: false,
+        cidr: `${address}/20`,
+        scopeid: 0,
+      }
+    : {
+        address,
+        netmask: "ffff:ffff:ffff:ffff::",
+        family,
+        mac: "00:00:00:00:00:00",
+        internal: false,
+        cidr: `${address}/64`,
+        scopeid: 0,
+      };
+
+describe("WSL 虚拟网卡地址筛选", () => {
+  it("只取 WSL / Hyper-V 虚拟网卡的地址，忽略物理网卡与热点", () => {
+    expect(
+      pickWslAddresses({
+        "vEthernet (WSL (Hyper-V firewall))": [iface("192.168.192.1")],
+        "WLAN 2": [iface("172.23.101.215")],
+        "本地连接* 2": [iface("192.168.137.1")],
+      }),
+    ).toEqual(["192.168.192.1"]);
+  });
+
+  it("过滤 IPv6 与内部地址，并对重复地址去重", () => {
+    expect(
+      pickWslAddresses({
+        "vEthernet (WSL)": [iface("192.168.192.1"), iface("fe80::1", "IPv6")],
+        "vEthernet (WSL (Hyper-V firewall))": [iface("192.168.192.1")],
+      }),
+    ).toEqual(["192.168.192.1"]);
+  });
+
+  it("没有虚拟网卡时返回空数组", () => {
+    expect(pickWslAddresses({ eth0: [iface("192.168.205.92")] })).toEqual([]);
+  });
+});
