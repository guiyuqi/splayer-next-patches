+import { callNetease } from "@main/apis/netease";
+import { programToTrack, toDjRadio } from "@shared/utils/radio";
+import type { NeteaseDjProgram, NeteaseDjRadio } from "@shared/types/radio";
+import type { Playlist, Track } from "@shared/types/player";
+import { getNeteaseUserId } from "./playlists";
+
+/** 订阅列表分页大小与安全上限 */
+const SUBLIST_PAGE_SIZE = 100;
+const SUBLIST_MAX = 2000;
+/** 单次最多载入的节目数（电台可达上千集，MCP 侧按需取） */
+const PROGRAM_LIMIT_MAX = 600;
+
+/** 外部可读的节目条目 */
+export interface McpPodcastProgram {
+  /** 电台内的序号（从 1 开始，最新在前） */
+  index: number;
+  /** 节目 id */
+  programId: string;
+  /** 取址用的歌曲 id（= mainTrackId） */
+  trackId: string;
+  title: string;
+  durationMs: number;
+  listenerCount?: number;
+  createTimeMs?: number;
+  serialNum?: number;
+}
+
+/** 外部可读的电台条目 */
+export interface McpPodcastEntry extends Playlist {
+  /** 主播昵称 */
+  owner?: string;
+}
+
+/**
+ * 我订阅的播客（/dj/sublist，仅登录态可用）
+ * @returns 订阅的电台列表
+ */
+export const listSubscribedPodcasts = async (): Promise<{
+  podcasts: McpPodcastEntry[];
+  loggedIn: boolean;
+}> => {
+  const uid = await getNeteaseUserId();
+  if (uid === null) return { podcasts: [], loggedIn: false };
+
+  const podcasts: McpPodcastEntry[] = [];
+  for (let offset = 0; offset < SUBLIST_MAX; offset += SUBLIST_PAGE_SIZE) {
+    const { body } = await callNetease("dj_sublist", { limit: SUBLIST_PAGE_SIZE, offset });
+    const page = ((body?.djRadios ?? []) as NeteaseDjRadio[]).map(toDjRadio);
+    podcasts.push(...page);
+    if (page.length < SUBLIST_PAGE_SIZE) break;
+  }
+  return { podcasts, loggedIn: true };
+};
+
+/**
+ * 搜索播客（cloudsearch type 1009）
+ * @param keyword - 关键词
+ * @param limit - 返回数量
+ * @returns 命中的电台
+ */
+export const searchPodcasts = async (
+  keyword: string,
+  limit: number,
+): Promise<McpPodcastEntry[]> => {
+  const { body } = await callNetease("cloudsearch", {
+    keywords: keyword,
+    type: 1009,
+    limit,
+    offset: 0,
+  });
+  const radios = (body?.result?.djRadios ?? []) as NeteaseDjRadio[];
+  return radios.slice(0, limit).map(toDjRadio);
+};
+
+/**
+ * 电台详情 + 节目列表
+ * @param rid - 电台 id
+ * @param offset - 节目偏移（0 起）
+ * @param limit - 节目数量
+ * @returns 电台信息与节目
+ */
+export const getPodcast = async (
+  rid: string,
+  offset: number,
+  limit: number,
+): Promise<{
+  podcast: McpPodcastEntry | null;
+  programs: McpPodcastProgram[];
+  total: number;
+  hasMore: boolean;
+}> => {
+  const { body: detail } = await callNetease("dj_detail", { rid });
+  const raw = detail?.data as NeteaseDjRadio | undefined;
+  if (!raw) return { podcast: null, programs: [], total: 0, hasMore: false };
+
+  const { body } = await callNetease("dj_program", { rid, limit, offset, asc: false });
+  const programs = ((body?.programs ?? []) as NeteaseDjProgram[]).map((program, position) => ({
+    index: offset + position + 1,
+    programId: String(program.id),
+    trackId: String(program.mainSong?.id ?? program.mainTrackId ?? ""),
+    title: program.name,
+    durationMs: program.duration ?? program.mainSong?.duration ?? program.mainSong?.dt ?? 0,
+    ...(program.listenerCount != null ? { listenerCount: program.listenerCount } : {}),
+    ...(program.createTime != null ? { createTimeMs: program.createTime } : {}),
+    ...(program.serialNum != null ? { serialNum: program.serialNum } : {}),
+  }));
+
+  return {
+    podcast: toDjRadio(raw),
+    programs,
+    total: body?.count ?? raw.programCount ?? programs.length,
+    hasMore: programs.length === limit && offset + limit < (body?.count ?? Infinity),
+  };
+};
+
+/**
+ * 载入电台的节目为可播放曲目
+ * @param rid - 电台 id
+ * @param max - 最多载入多少集（最新在前）
+ * @returns 电台信息与曲目
+ */
+export const loadPodcastTracks = async (
+  rid: string,
+  max: number,
+): Promise<{ podcast: McpPodcastEntry | null; tracks: Track[] }> => {
+  const { body: detail } = await callNetease("dj_detail", { rid });
+  const raw = detail?.data as NeteaseDjRadio | undefined;
+  if (!raw) return { podcast: null, tracks: [] };
+
+  const capped = Math.min(Math.max(max, 1), PROGRAM_LIMIT_MAX);
+  const tracks: Track[] = [];
+  const pageSize = 200;
+  for (let offset = 0; offset < capped; offset += pageSize) {
+    const { body } = await callNetease("dj_program", {
+      rid,
+      limit: Math.min(pageSize, capped - offset),
+      offset,
+      asc: false,
+    });
+    const programs = (body?.programs ?? []) as NeteaseDjProgram[];
+    for (const program of programs) {
+      const track = programToTrack(program, raw);
+      if (track) tracks.push(track);
+    }
+    if (programs.length < pageSize) break;
+    // 连续大分页会触发网易云 405/406 风控
+    await new Promise((resolve) => setTimeout(resolve, 400));
+  }
+  return { podcast: toDjRadio(raw), tracks };
+};
