+/**
+ * 重排歌单曲序
+ *
+ * 本机歌单直接改 position（原子）；网易云只能删光重加（逆序提交），写后校验，不一致则回滚。
+ * @param entry - 歌单条目
+ * @param orderedIds - 期望的完整顺序
+ * @returns 前后顺序快照与回滚状态
+ */
+export const reorderPlaylistTracks = async (
+  entry: McpPlaylistEntry,
+  orderedIds: string[],
+): Promise<PlaylistMutationResult> => {
+  const beforeOrder = await getPlaylistOrder(entry);
+  const desired = orderedIds.map((id) => String(id).trim()).filter(Boolean);
+  if (desired.length !== beforeOrder.length) {
+    throw new Error(
+      `顺序数组必须与当前曲目集合一致：歌单有 ${beforeOrder.length} 首，收到 ${desired.length} 个 id`,
+    );
+  }
+  if (!isSameTrackOrder([...desired].sort(), [...beforeOrder].sort())) {
+    throw new Error("顺序数组包含不属于该歌单的 id，或漏掉了现有曲目");
+  }
+  if (isSameTrackOrder(beforeOrder, desired)) {
+    return { ok: true, affected: 0, beforeOrder, afterOrder: beforeOrder };
+  }
+
+  if (entry.source === "local") {
+    if (!localReorderTracks(entry.id, desired)) throw new Error("本机歌单重排失败");
+    return {
+      ok: true,
+      affected: desired.length,
+      beforeOrder,
+      afterOrder: await getPlaylistOrder(entry),
+    };
+  }
+
+  await callNetease("playlist_tracks", { op: "del", pid: entry.id, tracks: beforeOrder.join(",") });
+  await callNetease("playlist_tracks", {
+    op: "add",
+    pid: entry.id,
+    tracks: [...desired].reverse().join(","),
+  });
+  let afterOrder = await getPlaylistOrder(entry);
+
+  if (!isSameTrackOrder(afterOrder, desired)) {
+    await callNetease("playlist_tracks", {
+      op: "del",
+      pid: entry.id,
+      tracks: afterOrder.join(","),
+    });
+    await callNetease("playlist_tracks", {
+      op: "add",
+      pid: entry.id,
+      tracks: [...beforeOrder].reverse().join(","),
+    });
+    afterOrder = await getPlaylistOrder(entry);
+    return {
+      ok: false,
+      affected: 0,
+      beforeOrder,
+      afterOrder,
+      rolledBack: isSameTrackOrder(afterOrder, beforeOrder),
+      addTimeRefreshed: true,
+      note: NETEASE_REORDER_NOTE,
+    };
+  }
+
+  return {
+    ok: true,
+    affected: desired.length,
+    beforeOrder,
+    afterOrder,
+    addTimeRefreshed: true,
+    note: NETEASE_REORDER_NOTE,
+  };
+};
+
+/**
+ * 移动单首曲目到指定位置（1-based）
+ * @param entry - 歌单条目
+ * @param trackId - 要移动的曲目 id
+ * @param toIndex - 目标位置，从 1 开始
+ * @returns 前后顺序快照与回滚状态
+ */
+export const movePlaylistTrack = async (
+  entry: McpPlaylistEntry,
+  trackId: string,
+  toIndex: number,
+): Promise<PlaylistMutationResult> => {
+  const order = await getPlaylistOrder(entry);
+  const from = order.indexOf(String(trackId));
+  if (from < 0) throw new Error(`曲目 ${trackId} 不在该歌单中`);
+  const to = Math.max(1, Math.min(Math.trunc(toIndex), order.length)) - 1;
+  if (from === to) {
+    return { ok: true, affected: 0, beforeOrder: order, afterOrder: order };
+  }
+  const next = [...order];
+  next.splice(from, 1);
+  next.splice(to, 0, String(trackId));
+  return reorderPlaylistTracks(entry, next);
+};
+
+/**
+ * 新建歌单
+ * @param input - 名称、来源（默认网易云）、是否私密与可选初始曲目
+ * @returns 新歌单 id、名称、来源与实际写入数量
+ */
+export const createPlaylist = async (input: {
+  name: string;
+  source?: "local" | "netease";
+  isPrivate?: boolean;
+  trackIds?: string[];
+}): Promise<{ id: string; name: string; source: "local" | "netease"; added: number }> => {
+  const title = input.name.trim();
+  if (!title) throw new Error("歌单名称不能为空");
+  const trackIds = input.trackIds ?? [];
+
+  if (input.source === "local") {
+    const created = localCreatePlaylist({ title, type: "local" });
+    const added = trackIds.length > 0 ? localAddTracks(created.id, trackIds) : 0;
+    return { id: created.id, name: created.title, source: "local", added };
+  }
+
+  const { body } = await callNetease("playlist_create", {
+    name: title,
+    privacy: input.isPrivate ? 10 : 0,
+  });
+  const id = body?.id ?? body?.playlist?.id;
+  if (!id) throw new Error("网易云未返回新歌单 id");
+  const entry: McpPlaylistEntry = {
+    id: String(id),
+    name: title,
+    trackCount: 0,
+    source: "netease",
+    owned: true,
+  };
+  const added = trackIds.length > 0 ? (await addPlaylistTracks(entry, trackIds)).affected : 0;
+  return { id: String(id), name: title, source: "netease", added };
+};
+
+/**
+ * 重命名歌单
+ * @param entry - 歌单条目
+ * @param name - 新名称
+ * @returns 是否成功
+ */
+export const renamePlaylist = async (entry: McpPlaylistEntry, name: string): Promise<void> => {
+  const title = name.trim();
+  if (!title) throw new Error("歌单名称不能为空");
+  if (entry.source === "local") {
+    localUpdatePlaylist(entry.id, { title });
+    return;
+  }
+  await callNetease("playlist_name_update", { id: entry.id, name: title });
+};
+
+/**
+ * 修改歌单简介
+ * @param entry - 歌单条目
+ * @param description - 新简介，空串清空
+ * @returns 是否成功
+ */
+export const updatePlaylistDescription = async (
+  entry: McpPlaylistEntry,
+  description: string,
+): Promise<void> => {
+  if (entry.source === "local") {
+    localUpdatePlaylist(entry.id, { description });
+    return;
+  }
+  await callNetease("playlist_desc_update", { id: entry.id, desc: description });
+};
+
+/**
+ * 删除歌单
+ * @param entry - 歌单条目
+ */
+export const deletePlaylist = async (entry: McpPlaylistEntry): Promise<void> => {
+  if (entry.source === "local") {
+    localDeletePlaylist(entry.id);
+    return;
+  }
+  await callNetease("playlist_delete", { id: entry.id });
+};
+
+/**
+ * 收藏或取消收藏歌单（仅网易云）
+ * @param entry - 歌单条目
+ * @param subscribed - true 收藏 / false 取消
+ */
+export const setPlaylistSubscribed = async (
+  entry: McpPlaylistEntry,
+  subscribed: boolean,
+): Promise<void> => {
+  if (entry.source === "local") {
+    throw new Error("本机歌单不需要收藏操作");
+  }
+  await callNetease("playlist_subscribe", { id: entry.id, t: subscribed ? 1 : 2 });
+};
