@@ -0,0 +1,200 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { McpPlaylistEntry } from "./playlists";
+
+const mocks = vi.hoisted(() => ({
+  callNetease: vi.fn(),
+  localAddTracks: vi.fn(),
+  localCreatePlaylist: vi.fn(),
+  localDeletePlaylist: vi.fn(),
+  getPlaylist: vi.fn(),
+  localGetTrackIds: vi.fn(),
+  getPlaylists: vi.fn(),
+  localRemoveTracks: vi.fn(),
+  localReorderTracks: vi.fn(),
+  localUpdatePlaylist: vi.fn(),
+}));
+
+vi.mock("@main/apis/netease", () => ({ callNetease: mocks.callNetease }));
+vi.mock("@main/database/playlists", () => ({
+  addPlaylistTracks: mocks.localAddTracks,
+  createPlaylist: mocks.localCreatePlaylist,
+  deletePlaylist: mocks.localDeletePlaylist,
+  getPlaylist: mocks.getPlaylist,
+  getPlaylistTrackIds: mocks.localGetTrackIds,
+  getPlaylists: mocks.getPlaylists,
+  removePlaylistTracks: mocks.localRemoveTracks,
+  reorderPlaylistTracks: mocks.localReorderTracks,
+  updatePlaylist: mocks.localUpdatePlaylist,
+}));
+
+const {
+  addPlaylistTracks,
+  isSameTrackOrder,
+  movePlaylistTrack,
+  normalizeRawTrackIds,
+  reorderPlaylistTracks,
+} = await import("./playlists");
+
+const neteaseEntry: McpPlaylistEntry = {
+  id: "123",
+  name: "测试歌单",
+  trackCount: 3,
+  source: "netease",
+  owned: true,
+};
+
+const localEntry: McpPlaylistEntry = {
+  id: "pl_1",
+  name: "本机歌单",
+  trackCount: 3,
+  source: "local",
+  owned: true,
+};
+
+/** 让 playlist_detail 依次返回给定顺序，模拟写后校验 */
+const stubNeteaseOrders = (orders: string[][]): void => {
+  let index = 0;
+  mocks.callNetease.mockImplementation(async (name: string) => {
+    if (name !== "playlist_detail") return { body: { code: 200 } };
+    const order = orders[Math.min(index++, orders.length - 1)];
+    return { body: { playlist: { trackIds: order.map((id) => ({ id })) } } };
+  });
+};
+
+const playlistTracksCalls = () =>
+  mocks.callNetease.mock.calls.filter(([name]) => name === "playlist_tracks");
+
+beforeEach(() => {
+  vi.clearAllMocks();
+});
+
+describe("trackIds 归一化", () => {
+  it("支持数字、字符串化对象与缺失值", () => {
+    expect(normalizeRawTrackIds([1, { id: 2, at: 1700000000000 }, { id: 3 }])).toEqual([
+      { id: "1" },
+      { id: "2", addTimeMs: 1700000000000 },
+      { id: "3" },
+    ]);
+    expect(normalizeRawTrackIds(undefined)).toEqual([]);
+  });
+});
+
+describe("顺序一致性判断", () => {
+  it("数量、内容或顺序不同都算不一致", () => {
+    expect(isSameTrackOrder(["a", "b"], ["a", "b"])).toBe(true);
+    expect(isSameTrackOrder(["a", "b"], ["b", "a"])).toBe(false);
+    expect(isSameTrackOrder(["a"], ["a", "b"])).toBe(false);
+    expect(isSameTrackOrder([], [])).toBe(true);
+  });
+});
+
+describe("网易云新增曲目", () => {
+  it("逆序提交，保证歌单最终顺序与传入顺序一致", async () => {
+    stubNeteaseOrders([[], ["a", "b"]]);
+
+    const result = await addPlaylistTracks(neteaseEntry, ["a", "b"]);
+
+    expect(playlistTracksCalls()[0][1]).toEqual({ op: "add", pid: "123", tracks: "b,a" });
+    expect(result.beforeOrder).toEqual([]);
+    expect(result.afterOrder).toEqual(["a", "b"]);
+    expect(result.affected).toBe(2);
+    expect(result.note).toContain("插到歌单开头");
+  });
+});
+
+describe("网易云重排曲序", () => {
+  it("校验失败直接报错，不动歌单", async () => {
+    stubNeteaseOrders([["a", "b", "c"]]);
+
+    await expect(reorderPlaylistTracks(neteaseEntry, ["a", "b"])).rejects.toThrow(
+      "顺序数组必须与当前曲目集合一致",
+    );
+    await expect(reorderPlaylistTracks(neteaseEntry, ["a", "b", "x"])).rejects.toThrow(
+      "顺序数组包含不属于该歌单的 id",
+    );
+    expect(playlistTracksCalls()).toHaveLength(0);
+  });
+
+  it("顺序未变化时不做任何写操作", async () => {
+    stubNeteaseOrders([["a", "b", "c"]]);
+
+    const result = await reorderPlaylistTracks(neteaseEntry, ["a", "b", "c"]);
+
+    expect(result.affected).toBe(0);
+    expect(playlistTracksCalls()).toHaveLength(0);
+  });
+
+  it("清空后按目标顺序重加，并标记加入时间被刷新", async () => {
+    stubNeteaseOrders([
+      ["a", "b", "c"], // beforeOrder
+      ["c", "a", "b"], // 写后校验
+    ]);
+
+    const result = await reorderPlaylistTracks(neteaseEntry, ["c", "a", "b"]);
+
+    expect(playlistTracksCalls().map(([, params]) => params)).toEqual([
+      { op: "del", pid: "123", tracks: "a,b,c" },
+      { op: "add", pid: "123", tracks: "b,a,c" },
+    ]);
+    expect(result.ok).toBe(true);
+    expect(result.afterOrder).toEqual(["c", "a", "b"]);
+    expect(result.addTimeRefreshed).toBe(true);
+  });
+
+  it("服务端没按目标顺序落地时回滚到重排前顺序", async () => {
+    stubNeteaseOrders([
+      ["a", "b", "c"], // beforeOrder
+      ["a", "b", "c"], // 写后校验：顺序没变（服务端没生效）
+      ["a", "b", "c"], // 回滚后的确认
+    ]);
+
+    const result = await reorderPlaylistTracks(neteaseEntry, ["c", "a", "b"]);
+
+    expect(result.ok).toBe(false);
+    expect(result.rolledBack).toBe(true);
+    expect(result.afterOrder).toEqual(["a", "b", "c"]);
+    expect(playlistTracksCalls().map(([name, params]) => [name, params.op])).toEqual([
+      ["playlist_tracks", "del"],
+      ["playlist_tracks", "add"],
+      ["playlist_tracks", "del"],
+      ["playlist_tracks", "add"],
+    ]);
+  });
+});
+
+describe("本机歌单重排", () => {
+  it("直接改 position，失败即抛错", async () => {
+    mocks.localGetTrackIds.mockReturnValue(["a", "b", "c"]);
+    mocks.localReorderTracks.mockReturnValue(true);
+
+    const result = await reorderPlaylistTracks(localEntry, ["b", "a", "c"]);
+
+    expect(mocks.localReorderTracks).toHaveBeenCalledWith("pl_1", ["b", "a", "c"]);
+    expect(result.affected).toBe(3);
+  });
+});
+
+describe("移动歌单内单曲", () => {
+  it("按最小位移算出目标顺序", async () => {
+    stubNeteaseOrders([
+      ["a", "b", "c", "d"], // beforeOrder
+      ["d", "a", "b", "c"], // 写后校验
+    ]);
+
+    const result = await movePlaylistTrack(neteaseEntry, "d", 1);
+
+    expect(result.afterOrder).toEqual(["d", "a", "b", "c"]);
+  });
+
+  it("目标位置越界时夹到两端，曲目不存在则报错", async () => {
+    stubNeteaseOrders([
+      ["a", "b", "c"], // beforeOrder
+      ["a", "b", "c"], // 写后校验
+    ]);
+
+    await expect(movePlaylistTrack(neteaseEntry, "c", 99)).resolves.toMatchObject({
+      afterOrder: ["a", "b", "c"],
+    });
+    await expect(movePlaylistTrack(neteaseEntry, "zzz", 1)).rejects.toThrow("不在该歌单中");
+  });
+});
diff --git a/electron/main/services/mcp/playlists.ts b/electron/main/services/mcp/playlists.ts
