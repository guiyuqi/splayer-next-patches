index 0000000..13b18e2
--- /dev/null
+++ b/electron/main/services/mcp/playlists.ts
@@ -0,0 +1,548 @@
+import { callNetease } from "@main/apis/netease";
+import {
+  addPlaylistTracks as localAddTracks,
+  createPlaylist as localCreatePlaylist,
+  deletePlaylist as localDeletePlaylist,
+  getPlaylist,
+  getPlaylistTrackIds as localGetTrackIds,
+  getPlaylists,
+  removePlaylistTracks as localRemoveTracks,
+  reorderPlaylistTracks as localReorderTracks,
+  updatePlaylist as localUpdatePlaylist,
+} from "@main/database/playlists";
+import { songToTrack, type NeteaseRawSong, withPicSize } from "@shared/utils/netease";
+import type { Track } from "@shared/types/player";
+
+/** 曲目补尾单批上限，与渲染层 fetchPlaylist 保持一致 */
+const SONG_DETAIL_BATCH = 500;
+/** 单个歌单最多载入的曲目数，避免超大歌单撑爆队列 */
+const MAX_PLAYLIST_TRACKS = 2000;
+
+/** 网易云的写操作语义，必须原样告知调用方 */
+const NETEASE_HEAD_INSERT_NOTE =
+  "网易云新增曲目是逐个插到歌单开头：同一批 [A,B] 结果会变成 [B,A]。本服务内部已逆序提交，" +
+  "调用方只需按期望顺序传数组即可。";
+const NETEASE_REORDER_NOTE =
+  "网易云没有歌单内移动接口，重排用「清空后按目标顺序重加」实现：会刷新所有曲目的加入时间，" +
+  "且非原子（本服务已加校验与回滚）。";
+
+/** trackIds 可能是数字数组或对象数组（对象里带加入时间 at） */
+type RawTrackIds = (number | { id: number; at?: number })[] | undefined;
+
+/** 歌单接口原始字段（仅取用到的部分） */
+interface RawNeteasePlaylist {
+  id: number;
+  name: string;
+  trackCount?: number;
+  coverImgUrl?: string;
+  privacy?: number;
+  subscribed?: boolean;
+  creator?: { nickname?: string; userId?: number };
+  tracks?: NeteaseRawSong[];
+  trackIds?: RawTrackIds;
+}
+
+/** 外部可读的歌单条目 */
+export interface McpPlaylistEntry {
+  id: string;
+  name: string;
+  trackCount: number;
+  source: "local" | "netease";
+  owner?: string;
+  cover?: string;
+  /** 是否为当前账号自建（决定能否写） */
+  owned?: boolean;
+  /** 网易云隐私设置：0 公开 / 10 私密 */
+  privacy?: number;
+  /** 是否为收藏（非自建）歌单 */
+  subscribed?: boolean;
+}
+
+/** 写操作结果：一律带前后顺序快照，供调用方对账 */
+export interface PlaylistMutationResult {
+  ok: boolean;
+  /** 实际影响（新增/删除/重排）的曲目数 */
+  affected: number;
+  beforeOrder: string[];
+  afterOrder: string[];
+  /** 失败时是否已回滚到 beforeOrder */
+  rolledBack?: boolean;
+  /** 重排是否刷新了加入时间 */
+  addTimeRefreshed?: boolean;
+  note?: string;
+}
+
+/**
+ * 归一化 trackIds（服务端可能给数字或带 at 的对象）
+ * @param raw - 原始 trackIds
+ * @returns id 与加入时间
+ */
+export const normalizeRawTrackIds = (raw: RawTrackIds): { id: string; addTimeMs?: number }[] =>
+  (raw ?? []).map((item) =>
+    typeof item === "number"
+      ? { id: String(item) }
+      : { id: String(item.id), ...(item.at ? { addTimeMs: item.at } : {}) },
+  );
+
+/**
+ * 判断两个曲目 id 序列是否完全一致（数量、内容与顺序）
+ * @param left - 序列 A
+ * @param right - 序列 B
+ * @returns 是否一致
+ */
+export const isSameTrackOrder = (left: readonly string[], right: readonly string[]): boolean =>
+  left.length === right.length && left.every((id, index) => id === right[index]);
+
+/**
+ * 取当前网易云账号 uid
+ * @returns uid；未登录（匿名会话）时为 null
+ */
+export const getNeteaseUserId = async (): Promise<number | null> => {
+  const pick = (value: unknown): number | null =>
+    typeof value === "number" && value > 0 ? value : null;
+  try {
+    const { body } = await callNetease("login_status");
+    const uid = pick(body?.data?.profile?.userId) ?? pick(body?.data?.account?.id);
+    if (uid !== null) return uid;
+  } catch {
+    // 未登录时该接口会失败，继续用 user_account 兜底
+  }
+  try {
+    const { body } = await callNetease("user_account");
+    return pick(body?.profile?.userId) ?? pick(body?.account?.id);
+  } catch {
+    return null;
+  }
+};
+
+/** 本机歌单 → 外部条目 */
+const localEntries = (): McpPlaylistEntry[] =>
+  getPlaylists().map((item) => ({
+    id: item.id,
+    name: item.title,
+    trackCount: item.trackCount,
+    source: "local" as const,
+    owned: true,
+  }));
+
+/**
+ * 列出可播放的歌单：本机歌单 + 网易云账号歌单
+ * @returns 歌单条目与（网易云不可用时的）失败原因
+ */
+export const listPlaylists = async (): Promise<{
+  playlists: McpPlaylistEntry[];
+  neteaseError?: string;
+}> => {
+  const playlists = localEntries();
+  let neteaseError: string | undefined;
+  try {
+    const uid = await getNeteaseUserId();
+    if (uid === null) {
+      neteaseError = "网易云账号未登录，无法读取账号歌单";
+      return { playlists, neteaseError };
+    }
+    const { body } = await callNetease("user_playlist", { uid, limit: 1000, offset: 0 });
+    for (const raw of (body?.playlist ?? []) as RawNeteasePlaylist[]) {
+      const owned = raw.creator?.userId === uid;
+      playlists.push({
+        id: String(raw.id),
+        name: raw.name,
+        trackCount: raw.trackCount ?? 0,
+        source: "netease",
+        owner: raw.creator?.nickname,
+        cover: withPicSize(raw.coverImgUrl),
+        owned,
+        privacy: raw.privacy ?? 0,
+        subscribed: !owned,
+      });
+    }
+  } catch (error) {
+    neteaseError = error instanceof Error ? error.message : String(error);
+  }
+  return { playlists, neteaseError };
+};
+
+/**
+ * 按名称查找歌单，先精确匹配再去空白包含匹配
+ * @param name - 歌单名称
+ * @returns 命中的歌单条目；未命中时为 null
+ */
+export const findPlaylistByName = async (name: string): Promise<McpPlaylistEntry | null> => {
+  const { playlists } = await listPlaylists();
+  const target = name.trim();
+  const exact = playlists.filter((item) => item.name === target);
+  if (exact.length > 0) return exact.sort((a, b) => b.trackCount - a.trackCount)[0];
+  const fuzzy = playlists.filter((item) => item.name.includes(target));
+  if (fuzzy.length > 0) return fuzzy.sort((a, b) => b.trackCount - a.trackCount)[0];
+  return null;
+};
+
+/**
+ * 按 id 查找歌单
+ * @param id - 歌单 id
+ * @returns 歌单条目；未命中时为 null
+ */
+export const findPlaylistById = async (id: string): Promise<McpPlaylistEntry | null> => {
+  const { playlists } = await listPlaylists();
+  return playlists.find((item) => item.id === id) ?? null;
+};
+
+/** 拉取网易云歌单原始详情 */
+const fetchNeteasePlaylist = async (id: string): Promise<RawNeteasePlaylist> => {
+  const { body } = await callNetease("playlist_detail", { id });
+  const raw = body?.playlist as RawNeteasePlaylist | undefined;
+  if (!raw) throw new Error(`未找到歌单 ${id}`);
+  return raw;
+};
+
+/**
+ * 载入歌单曲目
+ * @param entry - 歌单条目
+ * @returns 歌单名、曲目、全量 id 顺序、加入时间与是否截断
+ */
+export const loadPlaylistTracks = async (
+  entry: McpPlaylistEntry,
+): Promise<{
+  name: string;
+  total: number;
+  tracks: Track[];
+  trackIds: string[];
+  addTimes: Record<string, number>;
+  truncated: boolean;
+}> => {
+  if (entry.source === "local") {
+    const detail = getPlaylist(entry.id);
+    if (!detail) throw new Error(`未找到本机歌单 ${entry.id}`);
+    const trackIds = localGetTrackIds(entry.id);
+    return {
+      name: detail.title,
+      total: detail.trackCount,
+      tracks: detail.tracks.slice(0, MAX_PLAYLIST_TRACKS),
+      trackIds,
+      addTimes: {},
+      truncated: detail.tracks.length > MAX_PLAYLIST_TRACKS,
+    };
+  }
+
+  const raw = await fetchNeteasePlaylist(entry.id);
+  const tracks = (raw.tracks ?? []).map(songToTrack);
+  const ids = normalizeRawTrackIds(raw.trackIds);
+  // playlist_detail 只返回前若干首完整歌曲，剩余按 trackIds 分批补尾
+  const have = new Set(tracks.map((track) => track.id));
+  const missing = ids.map((item) => item.id).filter((id) => !have.has(id));
+  for (
+    let i = 0;
+    i < missing.length && tracks.length < MAX_PLAYLIST_TRACKS;
+    i += SONG_DETAIL_BATCH
+  ) {
+    const chunk = missing.slice(i, i + SONG_DETAIL_BATCH);
+    const { body: detail } = await callNetease("song_detail", { ids: chunk.join(",") });
+    for (const song of (detail?.songs ?? []) as NeteaseRawSong[]) tracks.push(songToTrack(song));
+  }
+
+  const addTimes: Record<string, number> = {};
+  for (const item of ids) if (item.addTimeMs) addTimes[item.id] = item.addTimeMs;
+
+  return {
+    name: raw.name,
+    total: raw.trackCount ?? tracks.length,
+    tracks: orderTracksByIds(
+      tracks,
+      ids.map((item) => item.id),
+    ),
+    trackIds: ids.map((item) => item.id),
+    addTimes,
+    truncated: tracks.length > MAX_PLAYLIST_TRACKS,
+  };
+};
+
+/**
+ * 按 trackIds 顺序重排曲目对象
+ * @param tracks - 曲目对象（可能含截断补尾的额外项）
+ * @param order - 期望的 id 顺序
+ * @returns 按 order 排列的曲目
+ */
+const orderTracksByIds = (tracks: Track[], order: string[]): Track[] => {
+  const byId = new Map(tracks.map((track) => [track.id, track]));
+  const ordered = order.flatMap((id) => {
+    const track = byId.get(id);
+    return track ? [track] : [];
+  });
+  const seen = new Set(ordered.map((track) => track.id));
+  return [...ordered, ...tracks.filter((track) => !seen.has(track.id))];
+};
+
+/**
+ * 取歌单当前曲目 id 顺序（本机与网易云统一）
+ * @param entry - 歌单条目
+ * @returns 曲目 id 顺序
+ */
+export const getPlaylistOrder = async (entry: McpPlaylistEntry): Promise<string[]> => {
+  if (entry.source === "local") return localGetTrackIds(entry.id);
+  const raw = await fetchNeteasePlaylist(entry.id);
+  return normalizeRawTrackIds(raw.trackIds).map((item) => item.id);
+};
+
+/**
+ * 向歌单新增曲目
+ * @param entry - 歌单条目
+ * @param trackIds - 曲目 id 列表（按期望顺序传入）
+ * @returns 前后顺序快照
+ */
+export const addPlaylistTracks = async (
+  entry: McpPlaylistEntry,
+  trackIds: string[],
+): Promise<PlaylistMutationResult> => {
+  const ids = [...new Set(trackIds.map((id) => String(id).trim()).filter(Boolean))];
+  if (ids.length === 0) throw new Error("trackIds 不能为空");
+  const beforeOrder = await getPlaylistOrder(entry);
+
+  if (entry.source === "local") {
+    const affected = localAddTracks(entry.id, ids);
+    return { ok: true, affected, beforeOrder, afterOrder: await getPlaylistOrder(entry) };
+  }
+
+  // 逆序提交，让歌单最终顺序与传入顺序一致
+  await callNetease("playlist_tracks", {
+    op: "add",
+    pid: entry.id,
+    tracks: [...ids].reverse().join(","),
+  });
+  const afterOrder = await getPlaylistOrder(entry);
+  return {
+    ok: true,
+    affected: Math.max(0, afterOrder.length - beforeOrder.length),
+    beforeOrder,
+    afterOrder,
+    note: NETEASE_HEAD_INSERT_NOTE,
+  };
+};
+
+/**
+ * 从歌单移除曲目
+ * @param entry - 歌单条目
+ * @param trackIds - 曲目 id 列表
+ * @returns 前后顺序快照
+ */
+export const removePlaylistTracks = async (
+  entry: McpPlaylistEntry,
+  trackIds: string[],
+): Promise<PlaylistMutationResult> => {
+  const ids = [...new Set(trackIds.map((id) => String(id).trim()).filter(Boolean))];
+  if (ids.length === 0) throw new Error("trackIds 不能为空");
+  const beforeOrder = await getPlaylistOrder(entry);
+
+  if (entry.source === "local") {
+    const affected = localRemoveTracks(entry.id, ids);
+    return { ok: true, affected, beforeOrder, afterOrder: await getPlaylistOrder(entry) };
+  }
+
+  await callNetease("playlist_tracks", { op: "del", pid: entry.id, tracks: ids.join(",") });
+  const afterOrder = await getPlaylistOrder(entry);
+  return {
+    ok: true,
+    affected: Math.max(0, beforeOrder.length - afterOrder.length),
+    beforeOrder,
+    afterOrder,
+  };
