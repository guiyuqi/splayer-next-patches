index 0000000..3e33871
--- /dev/null
+++ b/electron/main/services/mcp/dshConfig.spec.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  buildDshBlock,
+  buildPatchContent,
+  DSH_BLOCK_END,
+  DSH_BLOCK_START,
+  isDshManaged,
+  parseWslDistroList,
+} from "./dshConfig";
+
+// logger 会把 electron 依赖链拉进测试环境，这里隔离掉
+vi.mock("@main/utils/logger", () => ({
+  nativeLog: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+const params = {
+  host: "192.168.192.1",
+  port: 14559,
+  accessKey: "test-key",
+};
+
+const block = buildDshBlock(params);
+
+describe("DSH patch 内容生成", () => {
+  it("只有自动生成块才算「已配置」，手写条目不算", () => {
+    const handWritten = ["- insert:", "    - id: mcp-splayer", "      name: x"].join("\n");
+
+    expect(isDshManaged(handWritten)).toBe(false);
+    expect(isDshManaged(buildPatchContent(handWritten, block))).toBe(true);
+  });
+
+  it("解析 wsl.exe 的 UTF-16LE 发行版列表（含空行与 NUL）", () => {
+    const raw = Buffer.from("Ubuntu\r\n\r\ndocker-desktop\0\r\n", "utf16le");
+
+    expect(parseWslDistroList(raw)).toEqual(["Ubuntu", "docker-desktop"]);
+    expect(parseWslDistroList("Ubuntu\n")).toEqual(["Ubuntu"]);
+  });
+
+  it("生成带标记的 streamable-http 条目", () => {
+    expect(block.startsWith(DSH_BLOCK_START)).toBe(true);
+    expect(block.endsWith(DSH_BLOCK_END)).toBe(true);
+    expect(block).toContain("url: http://192.168.192.1:14559/mcp");
+    expect(block).toContain("X-MCP-Key: test-key");
+    expect(block).toContain("transport: streamable-http");
+  });
+
+  it("空文件直接追加并补换行", () => {
+    expect(buildPatchContent("", block)).toBe(`${block}\n`);
+  });
+
+  it("已有其它条目时追加到末尾，保留原有内容", () => {
+    const original = "# 说明\n- insert:\n    - id: other\n      name: x\n";
+    const next = buildPatchContent(original, block);
+
+    expect(next).toContain("- id: other");
+    expect(next.trimEnd().endsWith(DSH_BLOCK_END)).toBe(true);
+    expect(next).toContain(DSH_BLOCK_START);
+  });
+
+  it("替换手写的 mcp-splayer 条目，且不吞掉后续注释", () => {
+    const original = [
+      "# 头部说明",
+      "- insert:",
+      "    - id: mcp-splayer",
+      "      name: '@deepseek-ai/dsh-mcp-client'",
+      "      config:",
+      "        transport: stdio",
+      "",
+      "# 尾部说明：不要动我",
+    ].join("\n");
+    const next = buildPatchContent(original, block);
+
+    expect(next).toContain("# 头部说明");
+    expect(next).toContain("# 尾部说明：不要动我");
+    expect(next).toContain("transport: streamable-http");
+    expect(next).not.toContain("transport: stdio");
+    expect(next.match(/mcp-splayer/g)).toHaveLength(1);
+  });
+
+  it("重复注入保持单块（幂等）", () => {
+    const once = buildPatchContent("# 说明\n- insert:\n    - id: other\n      name: x\n", block);
+    const twice = buildPatchContent(once, block);
+
+    expect(twice).toBe(once);
+    expect(
+      twice.match(new RegExp(DSH_BLOCK_START.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "g")),
+    ).toHaveLength(1);
+  });
+
+  it("无法定位顶层 insert 时退回追加，不动原文件", () => {
+    const original = "config:\n  id: mcp-splayer\n";
+    const next = buildPatchContent(original, block);
+
+    expect(next).toContain("config:\n  id: mcp-splayer");
+    expect(next).toContain(DSH_BLOCK_START);
+  });
+});
diff --git a/electron/main/services/mcp/dshConfig.ts b/electron/main/services/mcp/dshConfig.ts
new file mode 100644
index 0000000..a2870aa
--- /dev/null
+++ b/electron/main/services/mcp/dshConfig.ts
@@ -0,0 +1,209 @@
+/**
+ * DSH（DeepSeek Harness）MCP 配置注入
+ *
+ * DSH 运行在 WSL 内，配置不是 mcpServers JSON，而是 profile 的 loader patch YAML
+ * （`~/.dsh/profiles/<profile>/cordis.patch.yml`）。本模块负责定位该文件、生成
+ * streamable-http 条目，并做「标记块 / 手写条目」两种形态的原地替换。
+ */
+
+import { execFile } from "node:child_process";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { promisify } from "node:util";
+import { nativeLog } from "@main/utils/logger";
+import type { McpClientConfigParams } from "@shared/types/settings";
+
+const run = promisify(execFile);
+
+/** WSL 发行版根目录候选（新版别名优先） */
+const WSL_ROOTS = ["\\\\wsl.localhost\\", "\\\\wsl$\\"];
+/** 自动生成块的首标记 */
+export const DSH_BLOCK_START = "# >>> splayer-next mcp (auto-generated)";
+/** 自动生成块的尾标记 */
+export const DSH_BLOCK_END = "# <<< splayer-next mcp";
+
+/** 解析到的 DSH 配置目标 */
+export interface DshTarget {
+  /** WSL 发行版名 */
+  distro: string;
+  /** profile patch 文件路径（Windows UNC 形式） */
+  patchPath: string;
+}
+
+/**
+ * 解析 `wsl.exe -l -q` 的输出
+ *
+ * wsl.exe 输出为 UTF-16LE，且带空行与结尾 NUL；按是否含 NUL 判断编码后清洗。
+ * @param output - 命令原始输出
+ * @returns 发行版名列表
+ */
+export const parseWslDistroList = (output: Buffer | string): string[] => {
+  const buffer = typeof output === "string" ? Buffer.from(output, "utf-8") : output;
+  const text = buffer.includes(0) ? buffer.toString("utf16le") : buffer.toString("utf-8");
+  return text
+    .split(/\r?\n/)
+    .map((line) => line.replace(/\0/g, "").trim())
+    .filter(Boolean);
+};
+
+/**
+ * 列出发行版
+ *
+ * `\\wsl.localhost\` 这类 UNC 根目录无法被枚举（系统 API 只接受 \\server\share），
+ * 因此优先走 wsl.exe；没有 wsl.exe（非 Windows）或调用失败时退回目录枚举。
+ * @returns 发行版名列表
+ */
+const listWslDistros = async (): Promise<string[]> => {
+  try {
+    const { stdout } = await run("wsl.exe", ["-l", "-q"], {
+      windowsHide: true,
+      timeout: 2500,
+      encoding: "buffer",
+    });
+    const distros = parseWslDistroList(stdout as unknown as Buffer);
+    if (distros.length > 0) return distros;
+  } catch {
+    // 非 Windows 或 wsl.exe 不可用时走下面的目录枚举
+  }
+  for (const root of WSL_ROOTS) {
+    const distros = await fs.readdir(root).catch(() => [] as string[]);
+    if (distros.length > 0) return distros;
+  }
+  return [];
+};
+
+/** 探测结果缓存时长：检测流程会连续问两次路径，且 WSL 读取较慢 */
+const TARGET_CACHE_MS = 30_000;
+
+/** 缓存的目标与写入时刻 */
+let cachedTarget: { value: DshTarget | null; at: number } | null = null;
+
+/**
+ * 定位 WSL 内的 DSH profile patch 文件
+ *
+ * 结果缓存 30 秒：一次弹窗检测会分别调用 getConfigPath 与 getInstallPaths，
+ * 每次都跑 wsl.exe + UNC 扫描会让界面明显发涩；注入时强制重新探测。
+ * @param refresh - 是否忽略缓存
+ * @returns 目标信息；未找到时返回 null
+ */
+export const findDshTarget = async (refresh = false): Promise<DshTarget | null> => {
+  if (!refresh && cachedTarget && Date.now() - cachedTarget.at < TARGET_CACHE_MS) {
+    return cachedTarget.value;
+  }
+  const distros = await listWslDistros();
+  for (const distro of distros) {
+    for (const root of WSL_ROOTS) {
+      const homes = await fs.readdir(path.join(root, distro, "home")).catch(() => [] as string[]);
+      for (const user of homes) {
+        const profilesDir = path.join(root, distro, "home", user, ".dsh", "profiles");
+        const profiles = await fs.readdir(profilesDir).catch(() => [] as string[]);
+        if (profiles.length === 0) continue;
+        // Web 端是默认 profile；否则取第一个真正含 patch 文件的 profile
+        const withPatch: string[] = [];
+        for (const name of profiles) {
+          const exists = await fs.stat(path.join(profilesDir, name, "cordis.patch.yml")).then(
+            () => true,
+            () => false,
+          );
+          if (exists) withPatch.push(name);
+        }
+        const profile = profiles.includes("web")
+          ? "web"
+          : (withPatch[0] ?? profiles.find((name) => name !== "node_modules") ?? profiles[0]);
+        const target = { distro, patchPath: path.join(profilesDir, profile, "cordis.patch.yml") };
+        cachedTarget = { value: target, at: Date.now() };
+        return target;
+      }
+    }
+  }
+  cachedTarget = { value: null, at: Date.now() };
+  return null;
+};
+
+/**
+ * 判断 patch 内容是否已由本应用托管
+ *
+ * 只认自动生成块：手写条目（用户或早期版本手工加的）不算，否则界面会把它显示成
+ * 「已配置」并禁用按钮，导致换密钥/换监听范围后无法重新注入。
+ * @param content - patch 文件内容
+ * @returns 是否含自动生成块
+ */
+export const isDshManaged = (content: string): boolean => content.includes(DSH_BLOCK_START);
+
+/**
+ * 生成 DSH 的 MCP 条目块
+ * @param params - 连接参数（host 必须是 WSL/局域网可达地址）
+ * @returns 带标记的 YAML 片段
+ */
+export const buildDshBlock = (params: McpClientConfigParams): string =>
+  [
+    DSH_BLOCK_START,
+    "- insert:",
+    "    - id: mcp-splayer",
+    "      name: '@deepseek-ai/dsh-mcp-client'",
+    "      config:",
+    "        serverName: splayer",
+    "        transport: streamable-http",
+    `        url: http://${params.host}:${params.port}/mcp`,
+    "        headers:",
+    `          X-MCP-Key: ${params.accessKey}`,
+  ].join("\n") +
+  "\n" +
+  DSH_BLOCK_END;
+
+/**
+ * 把条目块写进 patch 文件内容
+ *
+ * 依次尝试：替换已有的自动生成块 → 替换手写的 mcp-splayer 条目（按缩进边界取块）→ 追加到末尾
+ * @param original - 原文件内容
+ * @param block - 生成的条目块
+ * @returns 新的文件内容
+ */
+export const buildPatchContent = (original: string, block: string): string => {
+  const lines = original.split("\n");
+
+  const start = lines.findIndex((line) => line.trim() === DSH_BLOCK_START);
+  const end = lines.findIndex((line) => line.trim() === DSH_BLOCK_END);
+  if (start >= 0 && end > start) {
+    return [...lines.slice(0, start), block, ...lines.slice(end + 1)].join("\n");
+  }
+
+  const idIndex = lines.findIndex((line) => /^\s*-?\s*id:\s*mcp-splayer\s*$/.test(line));
+  if (idIndex >= 0) {
+    // 向上找到承载它的顶层 `- insert:` 行；找不到就不动原文件，退回追加
+    let from = idIndex;
+    while (from >= 0 && !/^-\s/.test(lines[from])) from--;
+    if (from >= 0) {
+      // 向下吃掉该条目的所有缩进行
+      let to = idIndex;
+      while (to + 1 < lines.length && /^\s+\S/.test(lines[to + 1])) to++;
+      return [...lines.slice(0, from), block, ...lines.slice(to + 1)].join("\n");
+    }
+  }
+
+  const trimmed = original.replace(/\s+$/, "");
+  return `${trimmed ? `${trimmed}\n\n` : ""}${block}\n`;
+};
+
+/**
+ * 把 SPlayer 的 MCP 配置注入 DSH
+ * @param params - 连接参数，host 需为 WSL 可达地址（loopback 会被拒绝）
+ */
+export const injectDshConfig = async (params: McpClientConfigParams): Promise<void> => {
+  if (params.host === "127.0.0.1" || params.host === "localhost") {
+    throw new Error(
+      "DSH 运行在 WSL 里，访问不到 Windows 回环地址：请先把「监听范围」改成「本机 + WSL 虚拟网卡」并点「重启服务」",
+    );
+  }
+  // 注入前强制重新探测：用户可能刚装好 WSL 或新建了 profile
+  const target = await findDshTarget(true);
+  if (!target) {
+    throw new Error("未在 WSL 中找到 DSH 配置目录（~/.dsh/profiles）");
+  }
+
+  const original = await fs.readFile(target.patchPath, "utf-8").catch(() => "");
+  const next = buildPatchContent(original, buildDshBlock(params));
+  await fs.mkdir(path.dirname(target.patchPath), { recursive: true });
+  await fs.writeFile(target.patchPath, next, "utf-8");
+  nativeLog.info(`已写入 DSH MCP 配置：${target.patchPath}（发行版 ${target.distro}）`);
+};
