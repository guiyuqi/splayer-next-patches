index 0000000..16aea7f
--- /dev/null
+++ b/electron/main/utils/lan.ts
@@ -0,0 +1,43 @@
+import os from "node:os";
+
+/**
+ * 取局域网展示地址，绑定 0.0.0.0 时作为展示给用户的局域网入口
+ * 优先常见家用/企业网段：WSL2/Hyper-V 的虚拟交换机常占用 172.x 且排在物理网卡前
+ */
+export const getLanAddress = (): string | null => {
+  const candidates: string[] = [];
+  for (const list of Object.values(os.networkInterfaces())) {
+    for (const item of list ?? []) {
+      if (item.family === "IPv4" && !item.internal) candidates.push(item.address);
+    }
+  }
+  return (
+    candidates.find((address) => address.startsWith("192.168.")) ??
+    candidates.find((address) => address.startsWith("10.")) ??
+    candidates[0] ??
+    null
+  );
+};
+
+/** WSL / Hyper-V 虚拟网卡名匹配；Windows 上形如 `vEthernet (WSL (Hyper-V firewall))` */
+const WSL_INTERFACE_RE = /wsl|hyper-v/i;
+
+/**
+ * 从网卡列表挑出 WSL / Hyper-V 虚拟网卡的 IPv4 地址
+ * 这些地址只对 WSL 侧的 Agent 可达，绑定它们即可让 WSL 直连而不把端口暴露给局域网
+ * @param interfaces - 网卡列表，形如 os.networkInterfaces() 的返回值
+ * @returns 去重后的地址列表；没有匹配网卡时为空数组
+ */
+export const pickWslAddresses = (interfaces: NodeJS.Dict<os.NetworkInterfaceInfo[]>): string[] => {
+  const addresses = new Set<string>();
+  for (const [name, list] of Object.entries(interfaces)) {
+    if (!WSL_INTERFACE_RE.test(name)) continue;
+    for (const item of list ?? []) {
+      if (item.family === "IPv4" && !item.internal) addresses.add(item.address);
+    }
+  }
+  return [...addresses];
+};
+
+/** 取本机 WSL / Hyper-V 虚拟网卡地址；非 Windows 或 WSL 未启用时为空数组 */
+export const getWslAddresses = (): string[] => pickWslAddresses(os.networkInterfaces());
