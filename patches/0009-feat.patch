+import { describe, expect, it } from "vitest";
+import { computeGainDb, MACRO_GAIN_LIMIT_DB, MACRO_PEAK_CEILING_DB } from "./gain";
+
+describe("宏音量增益换算", () => {
+  it("按目标响度给出增益", () => {
+    expect(computeGainDb(-12, -0.2, -18)).toBe(-6);
+    expect(computeGainDb(-24, -10, -18)).toBe(6);
+  });
+
+  it("抬升量被真峰值余量压住", () => {
+    // 需要 +6dB，但峰值只剩 2.8dB 余量
+    expect(computeGainDb(-24, -3.8, -18)).toBeCloseTo(2.8, 5);
+  });
+
+  it("衰减不受峰值约束", () => {
+    expect(computeGainDb(-6, -0.05, -18)).toBe(Math.max(-12, -12));
+  });
+
+  it("钳制在引擎前级范围内", () => {
+    expect(computeGainDb(-60, -40, -14)).toBe(MACRO_GAIN_LIMIT_DB);
+    expect(computeGainDb(0, -0.01, -23)).toBe(-MACRO_GAIN_LIMIT_DB);
+  });
+
+  it("峰值上限留了余量给限幅器", () => {
+    expect(MACRO_PEAK_CEILING_DB).toBeLessThan(0);
+  });
+});
