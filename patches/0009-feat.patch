diff --git a/electron/main/services/macroVolume.ts b/electron/main/services/macroVolume.ts
new file mode 100644
index 0000000..69a777a
--- /dev/null
+++ b/electron/main/services/macroVolume.ts
@@ -0,0 +1,74 @@
+/**
+ * 宏音量（整曲恒定增益）
+ *
+ * 每首歌测出整曲积分响度后算一个恒定增益，让不同歌曲的相对音量保持一致。
+ * 引擎侧没有独立的增益入口，这里复用均衡器前级：全频段 0dB 时滤波器是逐采样直通，
+ * 所以「开均衡器 + 只改前级」等价于给整首歌乘一个常数，同时顺带启用限幅器做削波保护。
+ *
+ * 组合规则固定在这里，避免渲染端与设置页各自拼前级导致互相覆盖。
+ */
+
+import { store } from "@main/store";
+import { setEqualizerEnabled, setNormalizationEnabled, setPreampGain } from "@main/services/engine";
+import { playerLog } from "@main/utils/logger";
+
+/** 前级允许范围（dB），超出会被引擎钳制 */
+const PREAMP_LIMIT_DB = 12;
+
+/** 当前曲目的宏音量增益（dB），0 表示不校准 */
+let macroGainDb = 0;
+
+const userPreampDb = (): number => store.get("player.equalizer.preamp") ?? 0;
+const userEqualizerEnabled = (): boolean => store.get("player.equalizer.enabled") === true;
+
+/**
+ * 把「用户前级 + 宏音量增益」写进引擎
+ *
+ * 宏音量生效时必须打开均衡器：前级只在均衡器启用时才参与处理，
+ * 而且这样限幅器也会介入，正增益不会把输出推到削波。
+ */
+export const applyGainChain = (): void => {
+  const userPreamp = userPreampDb();
+  const total = Math.max(-PREAMP_LIMIT_DB, Math.min(PREAMP_LIMIT_DB, userPreamp + macroGainDb));
+  if (total !== userPreamp + macroGainDb) {
+    playerLog.warn(`宏音量前级超范围已钳制: ${userPreamp + macroGainDb}dB → ${total}dB`);
+  }
+  setPreampGain(total);
+  setEqualizerEnabled(userEqualizerEnabled() || Math.abs(macroGainDb) > 0.01);
+};
+
+/**
+ * 设置当前曲目的宏音量增益
+ * @param gainDb - 恒定增益（dB），0 表示不校准
+ */
+export const setMacroGainDb = (gainDb: number): void => {
+  const value = Number.isFinite(gainDb) ? gainDb : 0;
+  if (Math.abs(value - macroGainDb) < 0.01) return;
+  macroGainDb = value;
+  if (value !== 0) ensureNormalizationOff();
+  applyGainChain();
+  playerLog.info(`宏音量增益已应用: ${value.toFixed(2)}dB`);
+};
+
+/**
+ * 确保宏音量与实时 AGC 不会同时生效
+ *
+ * 实时 AGC 会在播放过程中把响度拉回自己的目标，等于把宏音量的恒定增益抵消掉，
+ * 两者同时开启只会得到「既没对齐、又忽大忽小」。宏音量优先，这里把 AGC 关掉。
+ */
+export const ensureNormalizationOff = (): void => {
+  if (!store.get("player.loudnessNormalization")) return;
+  store.set("player.loudnessNormalization", false);
+  setNormalizationEnabled(false);
+  playerLog.info("宏音量生效中，已停用音量均衡（实时 AGC 会抵消恒定增益）");
+};
+
+/** 当前宏音量增益（dB） */
+export const getMacroGainDb = (): number => macroGainDb;
+
+/** 清空宏音量增益（换曲、关闭功能、场景不适用时调用） */
+export const resetMacroGain = (): void => {
+  if (macroGainDb === 0) return;
+  macroGainDb = 0;
+  applyGainChain();
+};
