@@ -0,0 +1,28 @@
+/**
+ * 宏音量增益换算
+ *
+ * 纯函数，与设置、引擎解耦，方便单测。
+ */
+
+/** 增益允许范围（dB），与引擎前级上限一致 */
+export const MACRO_GAIN_LIMIT_DB = 12;
+
+/** 真峰值上限（dBFS），留 1dB 余量给限幅器与采样峰值误差 */
+export const MACRO_PEAK_CEILING_DB = -1;
+
+/**
+ * 由整曲响度与峰值算恒定增益
+ *
+ * 先按目标响度算需要的增益，再用真峰值余量压一次：抬升不能让峰值越过上限，
+ * 否则限幅器会削掉瞬态，反而破坏「相对音量恒定」的初衷。
+ * @param lufs - 整曲积分响度（LUFS）
+ * @param peakDb - 整曲峰值电平（dBFS）
+ * @param targetLufs - 目标响度（LUFS）
+ * @returns 恒定增益（dB），已钳制在 ±MACRO_GAIN_LIMIT_DB 内
+ */
+export const computeGainDb = (lufs: number, peakDb: number, targetLufs: number): number => {
+  const desired = targetLufs - lufs;
+  const peakRoom = MACRO_PEAK_CEILING_DB - peakDb;
+  const bounded = Math.min(desired, peakRoom);
+  return Math.max(-MACRO_GAIN_LIMIT_DB, Math.min(MACRO_GAIN_LIMIT_DB, bounded));
+};
diff --git a/src/services/loudness/index.ts b/src/services/loudness/index.ts
