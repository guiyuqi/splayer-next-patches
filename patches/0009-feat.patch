index 0000000..2d1fe3f
--- /dev/null
+++ b/src/services/loudness/index.ts
@@ -0,0 +1,304 @@
+/**
+ * 宏音量（整曲恒定增益）
+ *
+ * 与「音量均衡」的实时 AGC 不同：每首歌只测一次整曲积分响度，之后整首歌都用
+ * 同一个恒定增益，因此不会出现段内忽大忽小。校准结果落本地，下次直接读取。
+ *
+ * 未校准的曲目先按 0dB 播放，等到缓存文件可读时在后台测量，下一次播放生效。
+ */
+
+import localforage from "localforage";
+import type { PlaybackContext, Track } from "@shared/types/player";
+import { useMediaStore } from "@/stores/media";
+import { useSettingsStore } from "@/stores/settings";
+import { cacheKeyForTrack, resolveTrackSource } from "@/services/audioSource";
+import * as cacheScheduler from "@/services/cacheScheduler";
+import { getNextTrackCandidate } from "@/core/player/candidate";
+import { useStatusStore } from "@/stores/status";
+import * as queue from "@/stores/queue";
+import { LOUDNESS_ALGO_VERSION, measureUrl, type LoudnessMeasurement } from "./measure";
+import { computeGainDb } from "./gain";
+
+/** 校准结果存储：键为 `{source}:{id}` */
+const store = localforage.createInstance({ name: "splayer", storeName: "loudness" });
+
+/** 单曲校准记录 */
+interface LoudnessRecord extends LoudnessMeasurement {
+  /** 算法版本，版本不同视为未校准 */
+  algo: number;
+  /** 测量完成时间 */
+  measuredAt: number;
+}
+
+/** 不参与宏音量对齐的来源类型：听整张专辑或播客时保持专辑内部动态 */
+const SKIP_ORIGIN_TYPES = new Set(["album", "radio"]);
+
+/** 正在测量的曲目键，避免重复测量 */
+const measuring = new Set<string>();
+
+/** 预校准进行中，同一时间只允许一条 */
+let premeasuring = false;
+
+/** 开播后等待多久再预校准下一首（毫秒） */
+const PREMEASURE_DELAY_MS = 8000;
+
+let premeasureTimer: ReturnType<typeof setTimeout> | null = null;
+
+/**
+ * 延迟为下一首做预校准
+ *
+ * 播放前无法判断用户是否会立刻跳过，这里等一小段时间、确认仍在这首歌上再动手。
+ * @param trackKey - 当前曲目键，用于确认没有换歌
+ */
+const schedulePremeasure = (trackKey: string): void => {
+  if (premeasureTimer) clearTimeout(premeasureTimer);
+  premeasureTimer = setTimeout(() => {
+    premeasureTimer = null;
+    const current = useMediaStore().track;
+    if (!current || keyForTrack(current) !== trackKey) return;
+    void premeasureNext();
+  }, PREMEASURE_DELAY_MS);
+};
+
+/** 曲目校准键 */
+const keyForTrack = (track: Track): string => `${track.source}:${track.id}`;
+
+/**
+ * 宏音量是否应作用于本次播放
+ * @param context - 本次播放的来源上下文
+ * @returns 是否参与对齐
+ */
+export const shouldApplyMacroVolume = (context?: PlaybackContext | null): boolean => {
+  const settings = useSettingsStore();
+  if (!settings.system.player.macroVolume?.enabled) return false;
+  // 专辑与播客内部本就有意设计的动态，强行对齐会破坏作品意图
+  if (context && SKIP_ORIGIN_TYPES.has(context.originType)) return false;
+  return true;
+};
+
+/**
+ * 读取已存的校准结果
+ * @param track - 歌曲信息
+ * @returns 校准记录，未校准或算法版本过期时返回 null
+ */
+export const getMeasurement = async (track: Track): Promise<LoudnessMeasurement | null> => {
+  try {
+    const record = await store.getItem<LoudnessRecord>(keyForTrack(track));
+    if (!record || record.algo !== LOUDNESS_ALGO_VERSION) return null;
+    if (!Number.isFinite(record.lufs) || !Number.isFinite(record.peakDb)) return null;
+    return { lufs: record.lufs, peakDb: record.peakDb };
+  } catch (error) {
+    console.warn("[loudness] 读取校准结果失败", error);
+    return null;
+  }
+};
+
+/**
+ * 由测量结果计算恒定增益
+ * @param measurement - 整曲响度与峰值
+ * @returns 增益（dB），正负均可能
+ */
+export const gainFromMeasurement = (measurement: LoudnessMeasurement): number => {
+  const target = useSettingsStore().system.player.macroVolume?.targetLufs ?? -18;
+  return computeGainDb(measurement.lufs, measurement.peakDb, target);
+};
+
+/**
+ * 测量并保存一首歌的整曲响度
+ * @param track - 歌曲信息
+ * @returns 增益（dB），无法测量时返回 null
+ */
+export const measureTrack = async (track: Track): Promise<number | null> => {
+  const settings = useSettingsStore();
+  const key = cacheKeyForTrack(track, settings.player.songLevel);
+  if (!key) return null;
+  const existing = await getMeasurement(track);
+  if (existing) return gainFromMeasurement(existing);
+  const fileKey = keyForTrack(track);
+  if (measuring.has(fileKey)) return null;
+  measuring.add(fileKey);
+  try {
+    const url = await window.api.cache.song.url(key);
+    if (!url) return null;
+    const measurement = await measureUrl(url);
+    const record: LoudnessRecord = {
+      ...measurement,
+      algo: LOUDNESS_ALGO_VERSION,
+      measuredAt: Date.now(),
+    };
+    await store.setItem(fileKey, record);
+    console.info(
+      `[loudness] 校准完成 ${track.title ?? track.id} ${measurement.lufs.toFixed(1)}LUFS peak=${measurement.peakDb.toFixed(1)}dB`,
+    );
+    return gainFromMeasurement(measurement);
+  } catch (error) {
+    console.warn(`[loudness] 校准失败 ${track.title ?? track.id}`, error);
+    return null;
+  } finally {
+    measuring.delete(fileKey);
+  }
+};
+
+/** 校准轮询的间隔（毫秒） */
+const CALIBRATION_POLL_MS = 2000;
+
+/** 校准轮询的最大次数（约 2 分钟，覆盖整首缓存下载） */
+const CALIBRATION_POLL_LIMIT = 60;
+
+/** 正在等待校准的曲目键，避免重复开轮询 */
+let calibratingKey: string | null = null;
+let calibratingTimer: ReturnType<typeof setInterval> | null = null;
+
+/** 停止校准轮询 */
+const stopCalibrationPoll = (): void => {
+  if (calibratingTimer) clearInterval(calibratingTimer);
+  calibratingTimer = null;
+  calibratingKey = null;
+};
+
+/**
+ * 边播边等缓存落地，测到就立刻把增益应用到当前曲目
+ *
+ * 未缓存的曲目在开播时拿不到音频，只能等缓存下载完成；测到后中途生效，
+ * 下一遍播放就能从第一个采样开始对齐。切歌会中止上一条轮询。
+ * @param track - 需要校准的曲目
+ */
+const watchCalibration = (track: Track): void => {
+  const key = keyForTrack(track);
+  if (calibratingKey === key) return;
+  stopCalibrationPoll();
+  calibratingKey = key;
+  let attempts = 0;
+  let settled = false;
+  const stop = (): void => {
+    settled = true;
+    stopCalibrationPoll();
+  };
+  const poll = async (): Promise<void> => {
+    if (settled) return;
+    attempts++;
+    const current = useMediaStore().track;
+    if (!current || keyForTrack(current) !== key || !settingsEnabled()) {
+      stop();
+      return;
+    }
+    // 20 秒阈值对宏音量太晚，这里直接催一次缓存下载
+    cacheScheduler.triggerNow();
+    const gain = await measureTrack(track);
+    if (gain !== null) {
+      stop();
+      const stillCurrent = useMediaStore().track;
+      if (stillCurrent && keyForTrack(stillCurrent) === key) {
+        await window.api.player.setMacroGain(gain);
+        console.info(`[loudness] 中途校准生效 ${track.title ?? track.id} ${gain.toFixed(2)}dB`);
+      }
+      return;
+    }
+    if (attempts >= CALIBRATION_POLL_LIMIT) stop();
+  };
+  calibratingTimer = setInterval(() => void poll(), CALIBRATION_POLL_MS);
+  void poll();
+};
+
+/** 宏音量开关当前是否打开 */
+const settingsEnabled = (): boolean =>
+  useSettingsStore().system.player.macroVolume?.enabled === true;
+
+/**
+ * 在播放前应用当前曲目的宏音量增益
+ *
+ * 只写增益，不改播放状态。已校准的曲目在开播前就设好，未校准的先按 0dB
+ * 播放并在缓存落地后中途生效，下一遍播放即从第一个采样起对齐。
+ * @param track - 即将播放的歌曲
+ * @param context - 本次播放的来源上下文
+ */
+export const applyMacroVolume = async (
+  track: Track | null,
+  context?: PlaybackContext | null,
+): Promise<void> => {
+  if (!track || !shouldApplyMacroVolume(context)) {
+    stopCalibrationPoll();
+    await window.api.player.setMacroGain(0);
+    return;
+  }
+  const measurement = await getMeasurement(track);
+  if (!measurement) {
+    await window.api.player.setMacroGain(0);
+    console.info(
+      `[loudness] 未校准，先按 0dB 播放 ${track.title ?? track.id}（缓存落地后中途生效）`,
+    );
+    watchCalibration(track);
+    return;
+  }
+  const gain = gainFromMeasurement(measurement);
+  stopCalibrationPoll();
+  await window.api.player.setMacroGain(gain);
+  console.info(`[loudness] 已对齐 ${track.title ?? track.id} ${gain.toFixed(2)}dB`);
+  schedulePremeasure(keyForTrack(track));
+};
+
+/**
+ * 提前校准下一首
+ *
+ * 队列里下一首如果等到开播才测量，前十几秒仍是未对齐的；这里在当前曲目校准完成后
+ * 顺手把下一首的缓存拉下来并测掉，代价是一首歌的缓存流量（缓存已开启时本来也要下载）。
+ */
+const premeasureNext = async (): Promise<void> => {
+  if (premeasuring) return;
+  const status = useStatusStore();
+  const next = getNextTrackCandidate({
+    playIndex: status.playIndex,
+    queue: queue.queue.value,
+    fmMode: status.fmMode,
+    skipKeywordsSongs: false,
+    skipTrackKeywords: [],
+    shuffleMode: status.shuffleMode,
+  });
+  if (!next) return;
+  const track = next.track;
+  if (await getMeasurement(track)) return;
+  const key = keyForTrack(track);
+  if (measuring.has(key)) return;
+  premeasuring = true;
+  measuring.add(key);
+  try {
+    const settings = useSettingsStore();
+    const cacheKey = cacheKeyForTrack(track, settings.player.songLevel);
+    if (!cacheKey) return;
+    // 还没缓存就先按播放时会走的同一套流程拉一份
+    let url = await window.api.cache.song.url(cacheKey);
+    if (!url) {
+      const source = await resolveTrackSource(track, { silent: true });
+      if (!source?.cacheRequest) return;
+      await source.cacheRequest();
+      url = await window.api.cache.song.url(cacheKey);
+    }
+    if (!url) return;
+    const measurement = await measureUrl(url);
+    await store.setItem(key, {
+      ...measurement,
+      algo: LOUDNESS_ALGO_VERSION,
+      measuredAt: Date.now(),
+    } satisfies LoudnessRecord);
+    console.info(`[loudness] 预校准 ${track.title ?? track.id} ${measurement.lufs.toFixed(1)}LUFS`);
+  } catch (error) {
+    console.warn(`[loudness] 预校准失败 ${track.title ?? track.id}`, error);
+  } finally {
+    measuring.delete(key);
+    premeasuring = false;
+  }
+};
+
+/** 关闭宏音量时立刻把增益归零 */
+export const clearMacroVolume = (): void => {
+  void window.api.player.setMacroGain(0);
+};
+
+/** 清空全部校准结果（切换目标响度或手动重新校准用） */
+export const clearMeasurements = async (): Promise<void> => {
+  try {
+    await store.clear();
+  } catch (error) {
+    console.warn("[loudness] 清空校准结果失败", error);
+  }
+};
diff --git a/src/services/loudness/measure.ts b/src/services/loudness/measure.ts
new file mode 100644
index 0000000..afa9037
--- /dev/null
+++ b/src/services/loudness/measure.ts
@@ -0,0 +1,236 @@
+/**
+ * 整曲响度测量（EBU R128 / ITU-R BS.1770-4）
+ *
+ * 用 Web Audio 解码缓存文件拿 PCM，再按标准做 K 加权与门限积分，
+ * 得到整曲的积分响度（LUFS）与峰值电平（dBFS）。
+ * 结果用于给每首歌算一个恒定的校准增益，使不同歌曲的相对音量一致。
+ */
+
+/** 测量结果 */
+export interface LoudnessMeasurement {
+  /** 积分响度（LUFS） */
+  lufs: number;
+  /** 峰值电平（dBFS，样本峰值） */
+  peakDb: number;
+}
+
+/**
+ * 算法版本
+ *
+ * 结果里不带版本号就无法分辨旧数据是否还适用，改动算法时递增即可整体重测
+ */
+export const LOUDNESS_ALGO_VERSION = 1;
+
+/** 绝对门限（LUFS），低于此值的块直接丢弃 */
+const ABSOLUTE_GATE_LUFS = -70;
+
+/** 相对门限偏移（LU），相对门限 = 通过绝对门限的块响度 - 该值 */
+const RELATIVE_GATE_LU = -10;
+
+/** 积分块时长（毫秒） */
+const BLOCK_MS = 400;
+
+/** 积分块重叠比例（75% 重叠 → 步长 100ms） */
+const BLOCK_STEP_RATIO = 0.25;
+
+/** 双通道下混到单声道的电平补偿（避免响度整体偏低） */
+const MONO_MIX_GAIN = Math.SQRT2;
+
+/**
+ * 一阶高通 + 高架滤波器（K 加权）
+ *
+ * 系数按采样率现算，48kHz 时与 BS.1770 给出的常数一致
+ */
+interface BiquadCoefficients {
+  b0: number;
+  b1: number;
+  b2: number;
+  a1: number;
+  a2: number;
+}
+
+/**
+ * 计算 K 加权第一级（高架，+4dB @ 1.5kHz 附近）系数
+ * @param sampleRate - 采样率（Hz）
+ * @returns 双二阶级联的第一级系数
+ */
+const highShelfCoefficients = (sampleRate: number): BiquadCoefficients => {
+  const f0 = 1681.974450955533;
+  const gainDb = 3.999843853973347;
+  const q = 0.7071752369554196;
+  const k = Math.tan((Math.PI * f0) / sampleRate);
+  const vh = Math.pow(10, gainDb / 20);
+  const vb = Math.pow(vh, 0.4996667741545416);
+  const a0 = 1 + k / q + k * k;
+  return {
+    b0: (vh + (vb * k) / q + k * k) / a0,
+    b1: (2 * (k * k - vh)) / a0,
+    b2: (vh - (vb * k) / q + k * k) / a0,
+    a1: (2 * (k * k - 1)) / a0,
+    a2: (1 - k / q + k * k) / a0,
+  };
+};
+
+/**
+ * 计算 K 加权第二级（高通，38Hz 附近）系数
+ * @param sampleRate - 采样率（Hz）
+ * @returns 双二阶级联的第二级系数
+ */
+const highPassCoefficients = (sampleRate: number): BiquadCoefficients => {
+  const f0 = 38.13547087602444;
+  const q = 0.5003270373238773;
+  const k = Math.tan((Math.PI * f0) / sampleRate);
+  const a0 = 1 + k / q + k * k;
+  return {
+    b0: 1,
+    b1: -2,
+    b2: 1,
+    a1: (2 * (k * k - 1)) / a0,
+    a2: (1 - k / q + k * k) / a0,
+  };
+};
+
+/**
+ * 就地应用双二阶级联（Direct Form II Transposed）
+ * @param samples - 单声道样本，就地修改
+ * @param first - 第一级系数
+ * @param second - 第二级系数
+ */
+const applyKWeighting = (
+  samples: Float32Array,
+  first: BiquadCoefficients,
+  second: BiquadCoefficients,
+): void => {
+  let z1 = 0;
+  let z2 = 0;
+  for (let i = 0; i < samples.length; i++) {
+    const x = samples[i];
+    const y = first.b0 * x + z1;
+    z1 = first.b1 * x - first.a1 * y + z2;
+    z2 = first.b2 * x - first.a2 * y;
+    samples[i] = y;
+  }
+  z1 = 0;
+  z2 = 0;
+  for (let i = 0; i < samples.length; i++) {
+    const x = samples[i];
+    const y = second.b0 * x + z1;
+    z1 = second.b1 * x - second.a1 * y + z2;
+    z2 = second.b2 * x - second.a2 * y;
+    samples[i] = y;
+  }
+};
+
+/**
+ * 把多声道缓冲下混成单声道
+ * @param buffer - 解码得到的音频缓冲
+ * @returns 单声道样本
+ */
+const toMono = (buffer: AudioBuffer): Float32Array => {
+  const channelCount = buffer.numberOfChannels;
+  const mono = new Float32Array(buffer.length);
+  for (let c = 0; c < channelCount; c++) {
+    const channel = buffer.getChannelData(c);
+    for (let i = 0; i < channel.length; i++) mono[i] += channel[i];
+  }
+  const scale = MONO_MIX_GAIN / channelCount;
+  for (let i = 0; i < mono.length; i++) mono[i] *= scale;
+  return mono;
+};
+
+/**
+ * 计算样本峰值电平
+ * @param buffer - 解码得到的音频缓冲
+ * @returns 峰值电平（dBFS），静音时返回 -Infinity
+ */
+const peakDbOf = (buffer: AudioBuffer): number => {
+  let peak = 0;
+  for (let c = 0; c < buffer.numberOfChannels; c++) {
+    const channel = buffer.getChannelData(c);
+    for (let i = 0; i < channel.length; i++) {
+      const value = Math.abs(channel[i]);
+      if (value > peak) peak = value;
+    }
+  }
+  return peak > 0 ? 20 * Math.log10(peak) : Number.NEGATIVE_INFINITY;
+};
+
+/**
+ * 按 BS.1770-4 计算积分响度
+ * @param mono - 单声道样本（已做 K 加权）
+ * @param sampleRate - 采样率（Hz）
+ * @returns 积分响度（LUFS），无可测内容时返回 -Infinity
+ */
+const integratedLufs = (mono: Float32Array, sampleRate: number): number => {
+  const blockLength = Math.max(1, Math.round((BLOCK_MS / 1000) * sampleRate));
+  const step = Math.max(1, Math.round(blockLength * BLOCK_STEP_RATIO));
+  const blockCount = Math.floor((mono.length - blockLength) / step) + 1;
+  if (blockCount <= 0) {
+    // 曲子比一个积分块还短，退化成整段均值
+    let sum = 0;
+    for (let i = 0; i < mono.length; i++) sum += mono[i] * mono[i];
+    const meanSquare = mono.length > 0 ? sum / mono.length : 0;
+    return meanSquare > 0 ? -0.691 + 10 * Math.log10(meanSquare) : Number.NEGATIVE_INFINITY;
+  }
+  const blockLoudness = new Float64Array(blockCount);
+  for (let b = 0; b < blockCount; b++) {
+    const start = b * step;
+    let sum = 0;
+    for (let i = 0; i < blockLength; i++) {
+      const value = mono[start + i];
+      sum += value * value;
+    }
+    const meanSquare = sum / blockLength;
+    blockLoudness[b] =
+      meanSquare > 0 ? -0.691 + 10 * Math.log10(meanSquare) : Number.NEGATIVE_INFINITY;
+  }
+  // 绝对门限
+  let sumGated = 0;
+  let gatedCount = 0;
+  for (let b = 0; b < blockCount; b++) {
+    if (blockLoudness[b] <= ABSOLUTE_GATE_LUFS) continue;
+    sumGated += Math.pow(10, blockLoudness[b] / 10);
+    gatedCount++;
+  }
+  if (gatedCount === 0) return Number.NEGATIVE_INFINITY;
+  const absoluteGatedLufs = 10 * Math.log10(sumGated / gatedCount);
+  // 相对门限
+  const relativeGate = absoluteGatedLufs + RELATIVE_GATE_LU;
+  let sumRelative = 0;
+  let relativeCount = 0;
+  for (let b = 0; b < blockCount; b++) {
+    if (blockLoudness[b] <= ABSOLUTE_GATE_LUFS || blockLoudness[b] <= relativeGate) continue;
+    sumRelative += Math.pow(10, blockLoudness[b] / 10);
+    relativeCount++;
+  }
+  if (relativeCount === 0) return absoluteGatedLufs;
+  return 10 * Math.log10(sumRelative / relativeCount);
+};
+
+/**
+ * 测量一个音频文件的整曲响度
+ * @param url - 可解码的音频地址（缓存文件走 cache:// 协议）
+ * @returns 积分响度与峰值；地址不可达或无法解码时抛错
+ */
+export const measureUrl = async (url: string): Promise<LoudnessMeasurement> => {
+  const response = await fetch(url);
+  if (!response.ok) throw new Error(`响度测量取样失败: HTTP ${response.status}`);
+  const data = await response.arrayBuffer();
+  if (data.byteLength === 0) throw new Error("响度测量取样为空");
+  const context = new AudioContext();
+  try {
+    const buffer = await context.decodeAudioData(data);
+    const peakDb = peakDbOf(buffer);
+    const mono = toMono(buffer);
+    applyKWeighting(
+      mono,
+      highShelfCoefficients(buffer.sampleRate),
+      highPassCoefficients(buffer.sampleRate),
+    );
+    const lufs = integratedLufs(mono, buffer.sampleRate);
+    if (!Number.isFinite(lufs)) throw new Error("响度测量无有效内容");
+    return { lufs, peakDb: Number.isFinite(peakDb) ? peakDb : -120 };
+  } finally {
+    void context.close();
+  }
+};
