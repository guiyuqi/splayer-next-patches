+ * 宏音量需要整首音频才能测响度，等 20 秒阈值太晚；调用方确认当前曲目仍是被
+ * 调度的那一首时会立刻下载，下载本身就发生在缓存已开启的前提下
+ * @returns 是否真的触发了下载
+ */
+export const triggerNow = (): boolean => {
+  if (!pending) return false;
+  if (useMediaStore().track?.id !== pending.trackId) {
+    pending = null;
+    return false;
+  }
+  const fire = pending.fire;
+  pending = null;
+  fire();
+  return true;
+};
+
 /** 取消当前 pending；切歌或新一轮加载前调用 */
 export const cancel = (): void => {
   pending = null;
