diff --git a/shared/utils/netease.ts b/shared/utils/netease.ts
new file mode 100644
index 0000000..2505a9d
--- /dev/null
+++ b/shared/utils/netease.ts
@@ -0,0 +1,120 @@
+import type { AudioQuality, Track, TrackFee } from "@shared/types/player";
+
+/**
+ * 网易云原始歌曲 → 应用层 Track 的纯映射
+ *
+ * 渲染层与主进程共用：渲染层用它把接口响应转成界面数据，主进程用它把歌单曲目
+ * 转成可入队的 Track。
+ */
+
+/** 单音质规格（仅取映射需要的字段） */
+interface RawQuality {
+  br: number;
+  sr: number;
+}
+
+/** 映射用到的原始歌曲字段；接口同时存在新旧两套命名，且可空 */
+export interface NeteaseRawSong {
+  id: number;
+  name: string;
+  /** 新命名歌手 */
+  ar?: { id: number; name?: string }[] | null;
+  /** 旧命名歌手 */
+  artists?: { id: number; name?: string }[] | null;
+  /** 新命名专辑 */
+  al?: { id: number; name: string; picUrl?: string } | null;
+  /** 旧命名专辑 */
+  album?: { id: number; name: string; picUrl?: string } | null;
+  alias?: string[] | null;
+  alia?: string[] | null;
+  /** 时长（毫秒） */
+  dt?: number | null;
+  duration?: number | null;
+  fee?: TrackFee | null;
+  /** 云盘歌曲标记，非 null 即视为云盘（具体结构不参与映射） */
+  pc?: unknown;
+  h?: RawQuality | null;
+  m?: RawQuality | null;
+  l?: RawQuality | null;
+  sq?: RawQuality | null;
+  hr?: RawQuality | null;
+}
+
+/** 按展示尺寸补齐封面地址 */
+export const withPicSize = (url: string | undefined, size = 300): string | undefined => {
+  if (!url) return undefined;
+  if (url.includes("?param=")) return url;
+  return `${url}?param=${size}y${size}`;
+};
+
+/** 从原始歌曲里挑出最高可用音质 */
+export const pickQuality = (song: NeteaseRawSong): AudioQuality | undefined => {
+  if (song.hr) {
+    return {
+      codec: "flac",
+      sampleRate: Math.max(song.hr.sr ?? 0, 96000),
+      bitsPerSample: 24,
+      bitRate: song.hr.br,
+      channels: 2,
+    };
+  }
+  if (song.sq) {
+    return {
+      codec: "flac",
+      sampleRate: song.sq.sr,
+      bitsPerSample: 16,
+      bitRate: song.sq.br,
+      channels: 2,
+    };
+  }
+  const mp3 = song.h ?? song.m ?? song.l;
+  if (mp3) {
+    return {
+      codec: "mp3",
+      sampleRate: mp3.sr,
+      bitsPerSample: 16,
+      bitRate: mp3.br,
+      channels: 2,
+    };
+  }
+  return undefined;
+};
+
+/**
+ * 网易云歌曲 → 队列用 Track
+ * @param song - 接口返回的原始歌曲
+ * @returns 应用层 Track
+ */
+export const songToTrack = (song: NeteaseRawSong): Track => {
+  // 兼容旧字段
+  const album = song.al ?? song.album;
+  const ar = song.ar ?? song.artists ?? [];
+  const aliasList = song.alia ?? song.alias;
+  const cover = withPicSize(album?.picUrl);
+  const coverOriginal = withPicSize(album?.picUrl, 1024);
+  const comment = aliasList?.find((s) => s?.trim()) ?? undefined;
+  return {
+    id: String(song.id),
+    source: "netease",
+    title: song.name,
+    comment,
+    artists: ar
+      .filter((artist) => artist.name?.trim())
+      .map((artist) => ({ id: String(artist.id), name: artist.name!.trim() })),
+    album: album ? { id: String(album.id), name: album.name, cover } : undefined,
+    duration: song.dt ?? song.duration ?? 0,
+    cover,
+    coverOriginal,
+    quality: pickQuality(song),
+    fee: song.fee ?? undefined,
+    cloud: song.pc != null ? true : undefined,
+  };
+};
+
+/**
+ * 批量转换网易云歌曲
+ * @param songs - 原始歌曲列表
+ * @returns Track 列表
+ */
+export const songsToTracks = (songs: NeteaseRawSong[] | undefined | null): Track[] =>
+  songs?.map(songToTrack) ?? [];
