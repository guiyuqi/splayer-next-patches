diff --git a/electron/main/apis/netease/modules/dj_sub.ts b/electron/main/apis/netease/modules/dj_sub.ts
new file mode 100644
index 0000000..2c155e3
--- /dev/null
+++ b/electron/main/apis/netease/modules/dj_sub.ts
@@ -0,0 +1,24 @@
+/**
+ * 订阅 / 取消订阅电台（播客）
+ *
+ * params:
+ * - rid  电台 id
+ * - t    1 订阅（默认）/ 0 或 2 取消订阅
+ *        仓库其它 `_sub` 模块用 1/2，前身 SPlayer 与网易云网页端用 1/0，这里两者都收
+ *
+ * 响应：`{ code }`
+ */
+
+import { createOption } from "../core/option";
+import type { NeteaseModule } from "../core/types";
+
+const djSub: NeteaseModule = (query, request) => {
+  const unsub = query.t === 0 || query.t === 2;
+  return request(
+    `/api/djradio/${unsub ? "unsub" : "sub"}`,
+    { id: query.rid },
+    createOption(query, "weapi"),
+  );
+};
+
+export default djSub;
