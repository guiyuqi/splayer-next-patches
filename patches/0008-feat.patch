+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { Track } from "@shared/types/player";
+import type { NeteaseDjProgram, NeteaseDjRadio } from "@shared/types/radio";
+
+// 渲染层的 netease Proxy 直接把 body 交给调用方（不是 { status, body }），mock 同样只回 body
+const mocks = vi.hoisted(() => ({
+  dj_catelist: vi.fn(),
+  dj_toplist: vi.fn(),
+  dj_sublist: vi.fn(),
+  dj_detail: vi.fn(),
+  dj_program: vi.fn(),
+  dj_program_detail: vi.fn(),
+  dj_sub: vi.fn(),
+  dj_category_recommend: vi.fn(),
+  dj_radio_hot: vi.fn(),
+  dj_recommend_type: vi.fn(),
+}));
+
+vi.mock("@/apis/netease", () => ({ netease: mocks }));
+
+const { fetchRadio, fetchRadioCategories, fetchRadioToplist, fetchUserRadios, subscribeRadio } =
+  await import("./netease");
+
+const radio: NeteaseDjRadio = {
+  id: 972022490,
+  name: "清音悦耳",
+  picUrl: "https://p1.music.126.net/cover.jpg",
+  programCount: 450,
+  dj: { nickname: "清尘伊笑" },
+};
+
+/** 造一页节目 */
+const page = (count: number, from = 0): NeteaseDjProgram[] =>
+  Array.from({ length: count }, (_, i) => ({
+    id: 1000 + from + i,
+    name: `第 ${from + i + 1} 集`,
+    duration: 60000,
+    mainTrackId: 5000 + from + i,
+    mainSong: { id: 5000 + from + i, name: `第 ${from + i + 1} 集`, fee: 0 },
+  }));
+
+/** 模拟风控错误（NeteaseRequestError 的形状） */
+const throttled = (): Error =>
+  Object.assign(new Error("netease 406: 操作频繁，请稍候再试"), {
+    name: "NeteaseRequestError",
+    response: { status: 406, body: { code: 406 } },
+  });
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.dj_detail.mockResolvedValue({ code: 200, data: radio });
+});
+
+describe("电台订阅", () => {
+  it("true 传 t=1、false 传 t=0，并校验响应 code", async () => {
+    mocks.dj_sub.mockResolvedValue({ code: 200 });
+
+    await subscribeRadio("972022490", true);
+    await subscribeRadio("972022490", false);
+
+    expect(mocks.dj_sub.mock.calls[0][0]).toEqual({ rid: "972022490", t: 1 });
+    expect(mocks.dj_sub.mock.calls[1][0]).toEqual({ rid: "972022490", t: 0 });
+  });
+
+  it("服务端 code 非 200 时抛出错误信息", async () => {
+    mocks.dj_sub.mockResolvedValue({ code: 301, msg: "需要登录" });
+
+    await expect(subscribeRadio("1", true)).rejects.toThrow("需要登录");
+  });
+});
+
+describe("电台列表映射", () => {
+  it("分类映射出 id/name", async () => {
+    mocks.dj_catelist.mockResolvedValue({
+      code: 200,
+      categories: [
+        { id: 3, name: "情感" },
+        { id: 2, name: "音乐播客" },
+      ],
+    });
+
+    expect(await fetchRadioCategories()).toEqual([
+      { id: 3, name: "情感" },
+      { id: 2, name: "音乐播客" },
+    ]);
+  });
+
+  it("热门榜映射成 Playlist（封面补参数、主播进 owner）", async () => {
+    mocks.dj_toplist.mockResolvedValue({ code: 200, toplist: [radio] });
+
+    expect(await fetchRadioToplist("hot", 5)).toEqual([
+      {
+        id: "972022490",
+        name: "清音悦耳",
+        cover: "https://p1.music.126.net/cover.jpg?param=300y300",
+        description: undefined,
+        trackCount: 450,
+        owner: "清尘伊笑",
+      },
+    ]);
+    expect(mocks.dj_toplist.mock.calls[0][0]).toMatchObject({ type: "hot", limit: 5 });
+  });
+
+  it("订阅列表分页拉全量（首页满页则继续）", async () => {
+    const full = Array.from({ length: 100 }, (_, i) => ({ ...radio, id: i + 1 }));
+    mocks.dj_sublist
+      .mockResolvedValueOnce({ code: 200, djRadios: full })
+      .mockResolvedValueOnce({ code: 200, djRadios: full.slice(0, 3) });
+
+    const podcasts = await fetchUserRadios();
+
+    expect(mocks.dj_sublist).toHaveBeenCalledTimes(2);
+    expect(mocks.dj_sublist.mock.calls[1][0]).toMatchObject({ offset: 100 });
+    expect(podcasts).toHaveLength(103);
+    expect(podcasts[0]).toMatchObject({ id: "1", name: "清音悦耳", owner: "清尘伊笑" });
+  });
+});
+
+describe("电台节目分页", () => {
+  it("按 200/页 拉取，元数据先回调、节目分批回调，末页不足即停", async () => {
+    mocks.dj_program
+      .mockResolvedValueOnce({ code: 200, programs: page(200, 0), count: 450 })
+      .mockResolvedValueOnce({ code: 200, programs: page(50, 200), count: 450 });
+
+    const meta: string[] = [];
+    const batches: Track[][] = [];
+    await fetchRadio("972022490", {
+      onMeta: (item) => meta.push(item.name),
+      onBatch: (batch) => batches.push(batch),
+    });
+
+    expect(meta).toEqual(["清音悦耳"]);
+    expect(batches.map((batch) => batch.length)).toEqual([200, 50]);
+    expect(mocks.dj_program.mock.calls[0][0]).toMatchObject({
+      rid: "972022490",
+      limit: 200,
+      offset: 0,
+    });
+    expect(mocks.dj_program.mock.calls[1][0]).toMatchObject({ offset: 200 });
+    // 每集都带节目 id（extId）与电台 id（album.id），打卡才认得出是播客
+    expect(batches[0][0]).toMatchObject({
+      id: "5000",
+      extId: "1000",
+      album: { id: "972022490", name: "清音悦耳" },
+      title: "第 1 集",
+      duration: 60000,
+    });
+  });
+
+  it("命中风控时等待后重试一次", async () => {
+    mocks.dj_program
+      .mockRejectedValueOnce(throttled())
+      .mockResolvedValueOnce({ code: 200, programs: page(2, 0) });
+
+    const batches: Track[][] = [];
+    await fetchRadio("972022490", { onBatch: (batch) => batches.push(batch) });
+
+    expect(mocks.dj_program).toHaveBeenCalledTimes(2);
+    expect(batches.map((batch) => batch.length)).toEqual([2]);
+  });
+
+  it("首页失败向上抛", async () => {
+    mocks.dj_program.mockRejectedValue(throttled());
+
+    await expect(fetchRadio("972022490", {})).rejects.toThrow("操作频繁");
+  });
+
+  it("后续页失败只截断尾部，保留已加载节目", async () => {
+    mocks.dj_program
+      .mockResolvedValueOnce({ code: 200, programs: page(200, 0) })
+      .mockRejectedValue(throttled());
+
+    const batches: Track[][] = [];
+    await expect(
+      fetchRadio("972022490", { onBatch: (batch) => batches.push(batch) }),
+    ).resolves.toBeUndefined();
+    expect(batches.map((batch) => batch.length)).toEqual([200]);
+  });
+
+  it("中断信号生效时不拉节目", async () => {
+    const controller = new AbortController();
+    controller.abort();
+
+    await fetchRadio("972022490", { signal: controller.signal });
+
+    expect(mocks.dj_detail).not.toHaveBeenCalled();
+    expect(mocks.dj_program).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/apis/radio/netease.ts b/src/apis/radio/netease.ts
new file mode 100644
index 0000000..5c581b0
--- /dev/null
+++ b/src/apis/radio/netease.ts
@@ -0,0 +1,193 @@
+import type { Playlist, Track } from "@shared/types/player";
+import { netease as neteaseApi } from "@/apis/netease";
+import { ensureOk } from "@/utils/format/netease";
+import { programToTrack, toDjRadio } from "@/utils/format/radio";
+import type { NeteaseDjProgram, NeteaseDjRadio } from "@shared/types/radio";
+
+/** 节目列表单页条数（接口上限约 200） */
+const PROGRAM_PAGE_SIZE = 200;
+/** 节目分页之间的间隔，连续请求会触发网易云 405/406 风控 */
+const PROGRAM_PAGE_DELAY_MS = 400;
+/** 命中风控后的重试等待 */
+const PROGRAM_RETRY_DELAY_MS = 1200;
+/** 节目分页安全上限（防接口异常导致死循环，正常电台远达不到） */
+const PROGRAM_MAX = 5000;
+/** 订阅列表单页条数与安全上限 */
+const SUBLIST_PAGE_SIZE = 100;
+const SUBLIST_MAX = 2000;
+
+/** 电台分类 */
+export interface RadioCategory {
+  id: number;
+  name: string;
+}
+
+/** 分类推荐分组（首页「按分类推荐」） */
+export interface RadioCategoryGroup {
+  id: number;
+  name: string;
+  radios: Playlist[];
+}
+
+/** fetchRadio 的可选参数 */
+export interface FetchRadioOptions {
+  /** 元数据回调 */
+  onMeta?: (radio: Playlist) => void;
+  /** 节目分批回调 */
+  onBatch?: (batch: Track[]) => void;
+  /** 中断信号 */
+  signal?: AbortSignal;
+}
+
+/** 电台分类列表（/dj/catelist） */
+export const fetchRadioCategories = async (): Promise<RadioCategory[]> => {
+  const body = await neteaseApi.dj_catelist();
+  return ((body?.categories ?? []) as RadioCategory[]).map((item) => ({
+    id: Number(item.id),
+    name: item.name,
+  }));
+};
+
+/**
+ * 热门电台榜（/dj/toplist）
+ * @param type - new 新晋榜 / hot 热门榜
+ * @param limit - 返回数量
+ */
+export const fetchRadioToplist = async (
+  type: "new" | "hot" = "hot",
+  limit = 30,
+): Promise<Playlist[]> => {
+  const body = await neteaseApi.dj_toplist({ type, limit, offset: 0 });
+  return ((body?.toplist ?? []) as NeteaseDjRadio[]).map(toDjRadio);
+};
+
+/** 分类推荐分组（/dj/category/recommend） */
+export const fetchRadioCategoryRecommend = async (): Promise<RadioCategoryGroup[]> => {
+  const body = await neteaseApi.dj_category_recommend();
+  const groups = (body?.data ?? []) as {
+    categoryId: number;
+    categoryName: string;
+    radios?: NeteaseDjRadio[];
+  }[];
+  return groups.map((group) => ({
+    id: Number(group.categoryId),
+    name: group.categoryName,
+    radios: (group.radios ?? []).map(toDjRadio),
+  }));
+};
+
+/**
+ * 分类下的热门电台（/dj/radio/hot）
+ * @param cateId - 分类 id
+ * @param limit - 返回数量
+ */
+export const fetchRadioCategoryHot = async (cateId: number, limit = 30): Promise<Playlist[]> => {
+  const body = await neteaseApi.dj_radio_hot({ cateId, limit, offset: 0 });
+  return ((body?.djRadios ?? []) as NeteaseDjRadio[]).map(toDjRadio);
+};
+
+/**
+ * 分类下的推荐电台（/dj/recommend/type）
+ * @param type - 分类 id
+ */
+export const fetchRadioRecommendByCategory = async (type: number): Promise<Playlist[]> => {
+  const body = await neteaseApi.dj_recommend_type({ type });
+  return ((body?.djRadios ?? []) as NeteaseDjRadio[]).map(toDjRadio);
+};
+
+/** 我订阅的电台（/dj/sublist），分页拉全量 */
+export const fetchUserRadios = async (): Promise<Playlist[]> => {
+  const all: Playlist[] = [];
+  for (let offset = 0; offset < SUBLIST_MAX; offset += SUBLIST_PAGE_SIZE) {
+    const body = await neteaseApi.dj_sublist({ limit: SUBLIST_PAGE_SIZE, offset });
+    const page = ((body?.djRadios ?? []) as NeteaseDjRadio[]).map(toDjRadio);
+    all.push(...page);
+    if (page.length < SUBLIST_PAGE_SIZE) break;
+  }
+  return all;
+};
+
+/** 判断是否为网易云风控限流（405/406 操作频繁） */
+const isThrottled = (error: unknown): boolean => {
+  const status = (error as { response?: { status?: number } })?.response?.status;
+  if (status === 405 || status === 406) return true;
+  return error instanceof Error && /netease 40[56]/.test(error.message);
+};
+
+/**
+ * 拉一页节目，遇到风控等待后重试一次
+ * @param rid - 电台 id
+ * @param offset - 偏移
+ * @returns 节目原始数组
+ */
+const fetchProgramPage = async (rid: string, offset: number): Promise<NeteaseDjProgram[]> => {
+  const query = { rid, limit: PROGRAM_PAGE_SIZE, offset, asc: false };
+  try {
+    const body = await neteaseApi.dj_program(query);
+    return (body?.programs ?? []) as NeteaseDjProgram[];
+  } catch (error) {
+    if (!isThrottled(error)) throw error;
+    await new Promise((resolve) => setTimeout(resolve, PROGRAM_RETRY_DELAY_MS));
+    const body = await neteaseApi.dj_program(query);
+    return (body?.programs ?? []) as NeteaseDjProgram[];
+  }
+};
+
+/**
+ * 拉取电台：元数据 + 节目（分页流式回调）
+ *
+ * 详情接口只给元数据，节目要按 `dj/program` 分页拉；大电台（上千集）边拉边上屏，
+ * 因此沿用与歌单一致的 onMeta/onBatch 契约。首页之后的限流失败只截断尾部，
+ * 不把已经拿到的节目丢掉。
+ * @param rid - 电台 id
+ * @param options - 元数据/节目回调与中断信号
+ */
+export const fetchRadio = async (rid: string, options: FetchRadioOptions = {}): Promise<void> => {
+  if (options.signal?.aborted) return;
+  const detail = await neteaseApi.dj_detail({ rid });
+  if (options.signal?.aborted) return;
+  const rawRadio = detail?.data as NeteaseDjRadio | undefined;
+  if (!rawRadio) return;
+  options.onMeta?.(toDjRadio(rawRadio));
+
+  const total = Math.min(Number(rawRadio.programCount) || PROGRAM_MAX, PROGRAM_MAX);
+  for (let offset = 0; offset < total; offset += PROGRAM_PAGE_SIZE) {
+    if (options.signal?.aborted) return;
+    // 连续大分页会触发风控，页间留一点间隔
+    if (offset > 0) await new Promise((resolve) => setTimeout(resolve, PROGRAM_PAGE_DELAY_MS));
+    let programs: NeteaseDjProgram[];
+    try {
+      programs = await fetchProgramPage(rid, offset);
+    } catch (error) {
+      // 第一页失败说明整体不可用，向上抛；后续页失败只截断尾部
+      if (offset === 0) throw error;
+      console.warn("[radio] 节目分页中断，已加载部分节目", error);
+      return;
+    }
+    if (options.signal?.aborted) return;
+    const batch = programs
+      .map((program) => programToTrack(program, rawRadio))
+      .filter((track): track is Track => track !== null);
+    if (batch.length > 0) options.onBatch?.(batch);
+    if (programs.length < PROGRAM_PAGE_SIZE) break;
+  }
+};
+
+/**
+ * 单个节目的曲目（用于「单集播放」，如搜索结果里的单集）
+ * @param programId - 节目 id
+ */
+export const fetchProgramTrack = async (programId: string): Promise<Track | null> => {
+  const body = await neteaseApi.dj_program_detail({ id: programId });
+  const program = body?.program as NeteaseDjProgram | undefined;
+  return program ? programToTrack(program) : null;
+};
+
+/**
+ * 订阅 / 取消订阅电台
+ * @param rid - 电台 id
+ * @param subscribe - true 订阅 / false 取消
+ */
+export const subscribeRadio = async (rid: string, subscribe: boolean): Promise<void> => {
+  ensureOk(await neteaseApi.dj_sub({ rid, t: subscribe ? 1 : 0 }));
+};
