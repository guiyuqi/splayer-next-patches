diff --git a/shared/types/radio.ts b/shared/types/radio.ts
new file mode 100644
index 0000000..a646d3f
--- /dev/null
+++ b/shared/types/radio.ts
@@ -0,0 +1,64 @@
+/**
+ * 网易云电台（播客）原始响应类型
+ *
+ * 跨进程共用（主进程 MCP 工具与渲染层都要做同样的映射）；
+ * 只列用得到的字段，接口字段可选且命名不统一（picUrl / coverUrl / interPicUrl），映射层负责兜底
+ */
+
+/** 电台（播客）作者/主播 */
+export interface NeteaseDjHost {
+  userId?: number | string;
+  nickname?: string;
+}
+
+/** 电台（播客）条目：/dj/toplist、/dj/hot、/dj/sublist、/dj/detail 的 data */
+export interface NeteaseDjRadio {
+  id: number | string;
+  name: string;
+  /** 封面（列表接口叫 picUrl，详情接口可能叫 interPicUrl） */
+  picUrl?: string;
+  interPicUrl?: string;
+  coverUrl?: string;
+  desc?: string;
+  rcmdtext?: string;
+  programCount?: number;
+  subCount?: number;
+  playCount?: number;
+  category?: string;
+  categoryId?: number | string;
+  /** 当前账号是否已订阅（仅详情接口返回） */
+  subed?: boolean;
+  dj?: NeteaseDjHost;
+  creatorName?: string;
+}
+
+/** 节目里的主歌曲（电台节目播放时真正取址用的 song） */
+export interface NeteaseDjMainSong {
+  id?: number | string;
+  name?: string;
+  fee?: number;
+  duration?: number;
+  dt?: number;
+  ar?: { id?: number | string; name?: string }[];
+  artists?: { id?: number | string; name?: string }[];
+  al?: { id?: number | string; name?: string; picUrl?: string };
+  album?: { id?: number | string; name?: string; picUrl?: string };
+}
+
+/** 电台节目（单集）：/dj/program、/dj/program/detail 的元素 */
+export interface NeteaseDjProgram {
+  id: number | string;
+  name: string;
+  duration?: number;
+  createTime?: number;
+  listenerCount?: number;
+  /** 期数 */
+  serialNum?: number;
+  coverUrl?: string;
+  blurCoverUrl?: string;
+  description?: string;
+  programDesc?: string;
+  mainTrackId?: number | string;
+  mainSong?: NeteaseDjMainSong;
+  radio?: NeteaseDjRadio;
+}
diff --git a/shared/utils/radio.ts b/shared/utils/radio.ts
new file mode 100644
index 0000000..2e9e009
--- /dev/null
+++ b/shared/utils/radio.ts
@@ -0,0 +1,77 @@
+import type { Artist, Playlist, Track } from "@shared/types/player";
+import { withPicSize } from "@shared/utils/netease";
+import type { NeteaseDjProgram, NeteaseDjRadio } from "@shared/types/radio";
+
+/**
+ * 电台（播客）映射：主进程与渲染层共用
+ *
+ * 三个关键约定（打卡按它们判定 `resourceType: "dj"`，见 shared/utils/neteaseScrobble.ts）：
+ * 播放取址只认 `Track.id = mainSong.id`、`Track.extId = 节目 id`、`Track.album.id = 电台 id`
+ */
+
+/**
+ * 电台封面（列表接口叫 picUrl，详情接口可能叫 interPicUrl）
+ * @param raw - 电台原始条目
+ * @returns 带尺寸参数的封面地址
+ */
+export const djRadioCover = (raw?: NeteaseDjRadio): string | undefined =>
+  raw ? withPicSize(raw.picUrl ?? raw.interPicUrl ?? raw.coverUrl) : undefined;
+
+/**
+ * 电台（播客）原始条目 → 应用层 Playlist
+ *
+ * 复用 Playlist 承载电台：`trackCount` 语义是「节目数」，`owner` 是主播昵称
+ * @param raw - /dj/toplist、/dj/hot、/dj/sublist 等接口的元素
+ * @returns 应用层 Playlist
+ */
+export const toDjRadio = (raw: NeteaseDjRadio): Playlist => ({
+  id: String(raw.id),
+  name: raw.name,
+  cover: djRadioCover(raw),
+  description: raw.desc ?? raw.rcmdtext,
+  trackCount: raw.programCount,
+  owner: raw.dj?.nickname ?? raw.creatorName,
+});
+
+/**
+ * 节目（单集）→ 可播放 Track
+ *
+ * 三个关键约定（打卡链路按它们判定 `resourceType: "dj"`，见 shared/utils/neteaseScrobble.ts）：
+ * - `id` 取 `mainSong.id`（播放取址只认 track.id）
+ * - `extId` 取节目 id
+ * - `album.id` 取电台 id
+ *
+ * @param program - /dj/program、/dj/program/detail 的元素
+ * @param radio - 节目所属电台（部分接口只在 program.radio 上带）
+ * @returns 可播放 Track；缺失主歌曲时为 null
+ */
+export const programToTrack = (program: NeteaseDjProgram, radio?: NeteaseDjRadio): Track | null => {
+  const song = program.mainSong;
+  const show = radio ?? program.radio;
+  const trackId = song?.id ?? program.mainTrackId;
+  if (trackId == null) return null;
+
+  const rawArtists = song?.ar ?? song?.artists ?? [];
+  const artists: Artist[] = rawArtists
+    .filter((artist) => artist?.name)
+    .map((artist) => ({
+      id: artist.id == null ? undefined : String(artist.id),
+      name: artist.name as string,
+    }));
+  if (artists.length === 0 && show?.name) artists.push({ name: show.name });
+
+  const cover = withPicSize(program.coverUrl ?? program.blurCoverUrl) ?? djRadioCover(show);
+
+  return {
+    id: String(trackId),
+    extId: String(program.id),
+    source: "netease",
+    title: program.name || song?.name || "",
+    artists,
+    album: show ? { id: String(show.id), name: show.name, cover: djRadioCover(show) } : undefined,
+    duration: program.duration ?? song?.duration ?? song?.dt ?? 0,
+    cover,
+    coverOriginal: withPicSize(program.coverUrl, 1024) ?? withPicSize(show?.picUrl, 1024),
+    fee: (song?.fee ?? 0) as Track["fee"],
+  };
+};
