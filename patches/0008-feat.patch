diff --git a/src/utils/format/radio.spec.ts b/src/utils/format/radio.spec.ts
new file mode 100644
index 0000000..28530c7
--- /dev/null
+++ b/src/utils/format/radio.spec.ts
@@ -0,0 +1,128 @@
+import { describe, expect, it } from "vitest";
+import type { NeteaseDjProgram, NeteaseDjRadio } from "@shared/types/radio";
+import { djRadioToCoverItem, programToTrack, toDjRadio } from "./radio";
+
+/** 一份贴近真实接口的电台详情返回（字段名按 /dj/toplist 与 /dj/detail 实测） */
+const radio: NeteaseDjRadio = {
+  id: 972022490,
+  name: "清音悦耳",
+  picUrl: "https://p4.music.126.net/cover.jpg",
+  desc: "最新最热，一次听完",
+  programCount: 787,
+  subCount: 43356,
+  dj: { userId: 6449043723, nickname: "清尘伊笑" },
+};
+
+/** 一份贴近真实接口的节目返回（mainSong 用经典字段名 artists/album/duration） */
+const program: NeteaseDjProgram = {
+  id: 3081834575,
+  name: "把不想做的事暂时放下",
+  duration: 1114226,
+  coverUrl: "https://p3.music.126.net/episode.jpg",
+  mainTrackId: 2730355242,
+  mainSong: {
+    id: 2730355242,
+    name: "把不想做的事暂时放下",
+    fee: 0,
+    duration: 1114226,
+    artists: [{ id: 0, name: "清尘伊笑" }],
+    album: { id: 0, name: "", picUrl: "https://p3.music.126.net/album.jpg" },
+  },
+  radio,
+};
+
+describe("电台条目映射", () => {
+  it("字段落到 Playlist：节目数当 trackCount、主播当 owner", () => {
+    expect(toDjRadio(radio)).toEqual({
+      id: "972022490",
+      name: "清音悦耳",
+      cover: "https://p4.music.126.net/cover.jpg?param=300y300",
+      description: "最新最热，一次听完",
+      trackCount: 787,
+      owner: "清尘伊笑",
+    });
+  });
+
+  it("详情接口的 interPicUrl 也能当封面", () => {
+    const detail = { ...radio, picUrl: undefined, interPicUrl: "https://p1.music.126.net/i.jpg" };
+    expect(toDjRadio(detail).cover).toBe("https://p1.music.126.net/i.jpg?param=300y300");
+  });
+
+  it("缺主播昵称时回退 creatorName", () => {
+    const raw = { id: 1, name: "无名电台", creatorName: "某人" };
+    expect(toDjRadio(raw).owner).toBe("某人");
+  });
+
+  it("封面卡片带主播副标题", () => {
+    expect(djRadioToCoverItem(toDjRadio(radio))).toMatchObject({
+      id: "972022490",
+      title: "清音悦耳",
+      subtitle: "清尘伊笑",
+      trackCount: 787,
+    });
+  });
+});
+
+describe("节目映射为可播放 Track", () => {
+  it("id 取 mainSong.id、extId 取节目 id、album.id 取电台 id（打卡按这三个判定 dj）", () => {
+    expect(programToTrack(program)).toMatchObject({
+      id: "2730355242",
+      extId: "3081834575",
+      source: "netease",
+      title: "把不想做的事暂时放下",
+      duration: 1114226,
+      artists: [{ id: "0", name: "清尘伊笑" }],
+      album: {
+        id: "972022490",
+        name: "清音悦耳",
+        cover: "https://p4.music.126.net/cover.jpg?param=300y300",
+      },
+      cover: "https://p3.music.126.net/episode.jpg?param=300y300",
+    });
+  });
+
+  it("新命名（ar/al/dt）与经典命名（artists/album/duration）都能映射", () => {
+    const modern: NeteaseDjProgram = {
+      ...program,
+      duration: undefined,
+      mainSong: {
+        id: 42,
+        name: "节目",
+        dt: 60000,
+        ar: [{ id: 7, name: "主播" }],
+        al: { id: 9, name: "专辑名", picUrl: "https://p.music.126.net/a.jpg" },
+      },
+    };
+    expect(programToTrack(modern)).toMatchObject({
+      id: "42",
+      duration: 60000,
+      artists: [{ id: "7", name: "主播" }],
+    });
+  });
+
+  it("节目自带 radio 时无需外部传入也能拿到电台 id", () => {
+    expect(programToTrack(program)?.album?.id).toBe("972022490");
+  });
+
+  it("没有 mainSong.id 时回退 mainTrackId，两者都没有则返回 null", () => {
+    const fallback: NeteaseDjProgram = {
+      id: 5,
+      name: "无主歌曲",
+      mainTrackId: 99,
+      mainSong: undefined,
+      radio,
+    };
+    expect(programToTrack(fallback)?.id).toBe("99");
+    expect(programToTrack({ id: 6, name: "空节目" })).toBeNull();
+  });
+
+  it("mainSong 没有歌手时用电台名兜底", () => {
+    const noArtist: NeteaseDjProgram = {
+      id: 7,
+      name: "节目",
+      mainSong: { id: 100, name: "节目", artists: [], album: undefined },
+      radio,
+    };
+    expect(programToTrack(noArtist)?.artists).toEqual([{ name: "清音悦耳" }]);
+  });
+});
