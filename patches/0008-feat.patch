+import type { Playlist } from "@shared/types/player";
+import { djRadioCover, programToTrack, toDjRadio } from "@shared/utils/radio";
+import type { CoverItem } from "@/types/artist";
+
+// 映射与主进程共用（见 shared/utils/radio.ts），这里保持原有导出面
+export { djRadioCover, programToTrack, toDjRadio };
+
+/**
+ * 电台（播客）→ 封面卡片
+ * @param radio - 应用层 Playlist
+ * @returns 展示模型 CoverItem
+ */
+export const djRadioToCoverItem = (radio: Playlist): CoverItem => ({
+  id: radio.id ?? "",
+  title: radio.name,
+  cover: radio.cover,
+  subtitle: radio.owner ?? "",
+  trackCount: radio.trackCount ?? 0,
+});
