diff --git a/src/pages/Podcast.vue b/src/pages/Podcast.vue
new file mode 100644
index 0000000..66935d3
--- /dev/null
+++ b/src/pages/Podcast.vue
@@ -0,0 +1,234 @@
+<script setup lang="ts">
+defineOptions({ name: "Podcast" });
+
+import type { Playlist } from "@shared/types/player";
+import type { CoverItem } from "@/types/artist";
+import {
+  fetchRadioCategories,
+  fetchRadioCategoryRecommend,
+  fetchRadioToplist,
+  type RadioCategory,
+} from "@/apis/radio/netease";
+import CoverList from "@/components/list/CoverList.vue";
+import { useUserStore } from "@/stores/user";
+import { useFloatingPlayerBar } from "@/composables/useFloatingPlayerBar";
+import { toast } from "@/composables/useToast";
+import { djRadioToCoverItem } from "@/utils/format/radio";
+
+const { t } = useI18n();
+const router = useRouter();
+const user = useUserStore();
+const { isFloatingBar } = useFloatingPlayerBar();
+
+/** 分类入口 */
+const categories = shallowRef<RadioCategory[]>([]);
+const categoriesLoading = ref(false);
+/** 热门推荐 */
+const hotItems = shallowRef<CoverItem[]>([]);
+const hotLoading = ref(false);
+/** 分类推荐分组 */
+const groups = shallowRef<{ id: number; name: string; items: CoverItem[] }[]>([]);
+const groupsLoading = ref(false);
+
+/** 同一次刷新只提示一次失败，避免接口整体挂掉时 toast 刷屏 */
+let notifiedFailure = false;
+
+const notifyFailure = (): void => {
+  if (notifiedFailure) return;
+  notifiedFailure = true;
+  toast.error(t("podcast.loadFailed"));
+};
+
+/** 电台 → 封面卡片 */
+const toItems = (radios: Playlist[]): CoverItem[] => radios.map(djRadioToCoverItem);
+
+/** 分类入口，失败不影响其它区块 */
+const loadCategories = async (): Promise<void> => {
+  categoriesLoading.value = true;
+  try {
+    categories.value = await fetchRadioCategories();
+  } catch {
+    categories.value = [];
+    notifyFailure();
+  } finally {
+    categoriesLoading.value = false;
+  }
+};
+
+/** 热门电台 */
+const loadHot = async (): Promise<void> => {
+  hotLoading.value = true;
+  try {
+    hotItems.value = toItems(await fetchRadioToplist("hot", 30));
+  } catch {
+    hotItems.value = [];
+    notifyFailure();
+  } finally {
+    hotLoading.value = false;
+  }
+};
+
+/** 分类推荐 */
+const loadCategoryRecommend = async (): Promise<void> => {
+  groupsLoading.value = true;
+  try {
+    const result = await fetchRadioCategoryRecommend();
+    groups.value = result.map((group) => ({
+      id: group.id,
+      name: group.name,
+      items: toItems(group.radios),
+    }));
+  } catch {
+    groups.value = [];
+    notifyFailure();
+  } finally {
+    groupsLoading.value = false;
+  }
+};
+
+/** 重新拉取全部区块 */
+const reload = (): void => {
+  notifiedFailure = false;
+  void loadCategories();
+  void loadHot();
+  void loadCategoryRecommend();
+};
+
+onMounted(reload);
+
+/** 我订阅的电台（登录后由 user store 统一拉取） */
+const subscriptionItems = computed<CoverItem[]>(() => toItems(user.radios));
+
+/** 打开电台详情 */
+const openRadio = (item: CoverItem): void => {
+  router.push(`/collection/netease/radio/${encodeURIComponent(item.id)}`);
+};
+
+/** 打开分类详情 */
+const openCategory = (category: RadioCategory): void => {
+  router.push({
+    name: "podcast-category",
+    params: { id: String(category.id) },
+    query: { name: category.name },
+  });
+};
+</script>
+
+<template>
+  <div class="h-full overflow-y-auto">
+    <div
+      class="mx-auto flex max-w-[1400px] flex-col gap-6 px-6 pt-6"
+      :class="isFloatingBar ? 'pb-28' : 'pb-10'"
+    >
+      <!-- 顶栏 -->
+      <header class="flex items-end justify-between gap-6">
+        <div class="min-w-0">
+          <h1 class="text-3xl font-bold text-on-surface text-balance">{{ t("podcast.title") }}</h1>
+          <p v-if="!user.isLoggedIn" class="mt-2 text-sm text-on-surface-variant/60">
+            {{ t("podcast.notLoggedIn") }}
+          </p>
+        </div>
+        <SButton
+          class="shrink-0"
+          variant="secondary"
+          size="small"
+          :loading="categoriesLoading || hotLoading || groupsLoading"
+          @click="reload"
+        >
+          <template #icon><IconLucideRefreshCw /></template>
+          {{ t("podcast.refresh") }}
+        </SButton>
+      </header>
+      <!-- 分类入口 -->
+      <section class="flex flex-col gap-3">
+        <h3 class="text-lg font-semibold text-on-surface">{{ t("podcast.categories") }}</h3>
+        <div
+          v-if="categoriesLoading"
+          class="flex items-center gap-2 text-sm text-on-surface-variant/50"
+        >
+          <SLoading class="size-3.5 text-primary/70 shrink-0" />
+          <span>{{ t("common.loading") }}</span>
+        </div>
+        <div
+          v-else-if="categories.length > 0"
+          class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6"
+        >
+          <SCard
+            v-for="category in categories"
+            :key="category.id"
+            radius="xl"
+            size="small"
+            hoverable
+            class="flex items-center gap-2"
+            @click="openCategory(category)"
+          >
+            <IconLucideRadio class="size-4 shrink-0 text-primary" />
+            <span class="truncate text-sm text-on-surface">{{ category.name }}</span>
+          </SCard>
+        </div>
+        <div
+          v-else
+          class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-on-surface/12 py-10 text-on-surface-variant/40"
+        >
+          <IconLucidePodcast class="size-7" />
+          <span class="text-sm">{{ t("podcast.empty") }}</span>
+        </div>
+      </section>
+      <!-- 我的订阅 -->
+      <section v-if="user.isLoggedIn" class="flex flex-col gap-3">
+        <h3 class="text-lg font-semibold text-on-surface">{{ t("podcast.mySubscriptions") }}</h3>
+        <CoverList
+          v-if="subscriptionItems.length > 0"
+          :items="subscriptionItems"
+          :virtual="false"
+          :gap="16"
+          @click="openRadio"
+        />
+        <div
+          v-else
+          class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-on-surface/12 py-10 text-on-surface-variant/40"
+        >
+          <IconLucidePodcast class="size-7" />
+          <span class="text-sm">{{ t("podcast.emptySubscription") }}</span>
+        </div>
+      </section>
+      <!-- 热门推荐 -->
+      <section class="flex flex-col gap-3">
+        <h3 class="text-lg font-semibold text-on-surface">{{ t("podcast.hot") }}</h3>
+        <div v-if="hotLoading" class="flex items-center gap-2 text-sm text-on-surface-variant/50">
+          <SLoading class="size-3.5 text-primary/70 shrink-0" />
+          <span>{{ t("common.loading") }}</span>
+        </div>
+        <CoverList
+          v-else-if="hotItems.length > 0"
+          :items="hotItems"
+          :virtual="false"
+          :gap="16"
+          @click="openRadio"
+        />
+        <div
+          v-else
+          class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-on-surface/12 py-10 text-on-surface-variant/40"
+        >
+          <IconLucidePodcast class="size-7" />
+          <span class="text-sm">{{ t("podcast.empty") }}</span>
+        </div>
+      </section>
+      <!-- 分类推荐 -->
+      <section v-if="groupsLoading || groups.length > 0" class="flex flex-col gap-6">
+        <h3 class="text-lg font-semibold text-on-surface">{{ t("podcast.categoryRecommend") }}</h3>
+        <div
+          v-if="groupsLoading"
+          class="flex items-center gap-2 text-sm text-on-surface-variant/50"
+        >
+          <SLoading class="size-3.5 text-primary/70 shrink-0" />
+          <span>{{ t("common.loading") }}</span>
+        </div>
+        <div v-for="group in groups" :key="group.id" class="flex flex-col gap-3">
+          <h4 class="text-sm font-medium text-on-surface-variant/70">{{ group.name }}</h4>
+          <CoverList :items="group.items" :virtual="false" :gap="16" @click="openRadio" />
+        </div>
+      </section>
+    </div>
+  </div>
+</template>
diff --git a/src/pages/PodcastCategory.vue b/src/pages/PodcastCategory.vue
new file mode 100644
index 0000000..c11c629
--- /dev/null
+++ b/src/pages/PodcastCategory.vue
@@ -0,0 +1,130 @@
+<script setup lang="ts">
+defineOptions({ name: "PodcastCategory" });
+
+import type { CoverItem } from "@/types/artist";
+import { fetchRadioCategoryHot, fetchRadioRecommendByCategory } from "@/apis/radio/netease";
+import CoverList from "@/components/list/CoverList.vue";
+import { djRadioToCoverItem } from "@/utils/format/radio";
+
+type CategoryTab = "hot" | "recommend";
+
+const { t } = useI18n();
+const route = useRoute();
+const router = useRouter();
+
+/** 分类 id（路由参数） */
+const categoryId = computed(() => Number(route.params.id));
+
+/** 分类名称（列表页通过 query 带过来，缺失时回落到页面标题） */
+const categoryName = computed(() =>
+  typeof route.query.name === "string" && route.query.name ? route.query.name : t("podcast.title"),
+);
+
+const tabs = computed(() => [
+  { key: "hot" satisfies CategoryTab, label: t("podcast.tabs.hot") },
+  { key: "recommend" satisfies CategoryTab, label: t("podcast.tabs.recommend") },
+]);
+
+const activeTab = ref<CategoryTab>("hot");
+
+/** 每个页签各自的列表与加载状态，切换时按需加载并保留结果 */
+const items = reactive<Record<CategoryTab, CoverItem[]>>({ hot: [], recommend: [] });
+const loaded = reactive<Record<CategoryTab, boolean>>({ hot: false, recommend: false });
+const loading = ref(false);
+const error = ref("");
+
+/**
+ * 拉取指定页签
+ * @param tab - 页签 key
+ */
+const load = async (tab: CategoryTab): Promise<void> => {
+  if (loading.value || loaded[tab]) return;
+  loading.value = true;
+  error.value = "";
+  try {
+    const radios =
+      tab === "hot"
+        ? await fetchRadioCategoryHot(categoryId.value)
+        : await fetchRadioRecommendByCategory(categoryId.value);
+    items[tab] = radios.map(djRadioToCoverItem);
+    loaded[tab] = true;
+  } catch (err) {
+    error.value = err instanceof Error ? err.message : String(err);
+  } finally {
+    loading.value = false;
+  }
+};
+
+onMounted(() => void load("hot"));
+
+const onTabSwitch = (key: string): void => {
+  activeTab.value = key as CategoryTab;
+  void load(activeTab.value);
+};
+
+/** 失败后重试当前页签 */
+const onRetry = (): void => {
+  loaded[activeTab.value] = false;
+  error.value = "";
+  void load(activeTab.value);
+};
+
+/** 打开电台详情 */
+const openRadio = (item: CoverItem): void => {
+  router.push(`/collection/netease/radio/${encodeURIComponent(item.id)}`);
+};
+</script>
+
+<template>
+  <div class="flex flex-col h-full">
+    <!-- 顶栏 -->
+    <div class="shrink-0 px-5 pb-2">
+      <div class="flex items-center gap-3 mt-2 mb-4 min-w-0">
+        <SButton variant="ghost" size="small" class="shrink-0" @click="router.push('/podcast')">
+          <template #icon><IconLucideArrowLeft /></template>
+          {{ t("podcast.back") }}
+        </SButton>
+        <h1 class="truncate text-3xl font-bold text-on-surface text-balance">
+          {{ categoryName }}
+        </h1>
+      </div>
+      <STabs :model-value="activeTab" :tabs="tabs" @update:model-value="onTabSwitch" />
+    </div>
+    <!-- 加载中 -->
+    <div v-if="loading" class="flex-1 flex items-center justify-center">
+      <div class="text-center text-on-surface-variant/60">
+        <SLoading class="text-4xl text-primary/70 mb-4 mx-auto block" />
+        <div class="text-sm">{{ t("common.loading") }}</div>
+      </div>
+    </div>
+    <!-- 错误态 -->
+    <div v-else-if="error" class="flex-1 flex items-center justify-center px-6">
+      <div class="text-center text-red-500/85">
+        <IconLucideTriangleAlert class="size-14 mx-auto mb-4 opacity-50" />
+        <div class="text-sm font-medium mb-1">{{ t("podcast.loadFailed") }}</div>
+        <div class="text-xs opacity-80 break-all max-w-xs mb-4">{{ error }}</div>
+        <SButton variant="secondary" size="small" @click="onRetry">
+          <template #icon><IconLucideRefreshCw class="size-3.5" /></template>
+          {{ t("common.retry") }}
+        </SButton>
+      </div>
+    </div>
+    <!-- 列表 -->
+    <div v-else-if="items[activeTab].length > 0" class="flex-1 min-h-0">
+      <CoverList
+        :items="items[activeTab]"
+        :padding-x="20"
+        :padding-top="8"
+        :padding-bottom="20"
+        @click="openRadio"
+      />
+    </div>
+    <!-- 空态 -->
+    <div v-else class="flex-1 flex items-center justify-center">
+      <div class="text-center text-on-surface-variant/50">
+        <IconLucidePodcast class="size-12 mx-auto mb-3 opacity-30" />
+        <div class="text-sm">{{ t("podcast.emptyCategory") }}</div>
+      </div>
+    </div>
+  </div>
+</template>
